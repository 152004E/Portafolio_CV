---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Curriculum Vitae - Emerson Reyes">
  <style is:global>
    /* Ocultar el navbar principal y el botón de whatsapp en esta vista */
    nav, #whatsapp-btn { 
      display: none !important; 
    }
    
    /* Prevenir scroll del body porque el iframe tendrá su propio scroll si es necesario */
    body {
      overflow: hidden;
    }
  </style>
  
  <div class="h-screen w-screen flex flex-col bg-gray-900 relative z-50">
    <!-- Header custom para CV -->
    <div class="h-16 shrink-0 flex items-center justify-between px-4 sm:px-6 bg-gray-950 border-b border-white/10 shadow-lg relative z-30">
      <a href="/" class="curve-transition-link flex items-center gap-2 text-gray-400 hover:text-white transition-colors">
        <i class="fa-solid fa-arrow-left"></i>
        <span class="font-medium hidden sm:inline">Volver al Portafolio</span>
        <span class="font-medium sm:hidden">Volver</span>
      </a>
      
      <!-- Dropdown Opciones de Descarga CV -->
      <div class="relative" id="cv-dropdown-wrapper">
        <button
          id="cv-dropdown-btn"
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          class="flex items-center gap-2 rounded-full bg-linear-to-r from-blue-600 to-cyan-500 px-4 sm:px-5 py-2 text-sm font-semibold text-white hover:scale-105 transition-all shadow-lg hover:shadow-blue-500/25 cursor-pointer"
        >
          <i class="fa-solid fa-download"></i>
          <span>Descargar CV</span>
          <i id="cv-dropdown-chevron" class="fa-solid fa-chevron-down text-xs transition-transform duration-200"></i>
        </button>

        <!-- Menú Desplegable -->
        <div
          id="cv-dropdown-menu"
          class="absolute right-0 top-full mt-2 w-72 sm:w-80 rounded-2xl bg-gray-900/95 backdrop-blur-xl border border-white/15 shadow-2xl p-2 z-50 transition-all duration-200 opacity-0 pointer-events-none scale-95 origin-top-right"
        >
          <div class="px-3 py-2 text-xs font-semibold uppercase tracking-wider text-gray-400 border-b border-white/10 mb-1">
            Formatos disponibles
          </div>

          <!-- Opción 1: PDF Completo para PC -->
          <a
            href="/cv_emerson_reyes.pdf"
            download="CV_Emerson_Reyes.pdf"
            class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition-colors group cursor-pointer text-left"
          >
            <div class="w-10 h-10 rounded-lg bg-red-500/20 text-red-400 flex items-center justify-center shrink-0 text-lg group-hover:scale-110 group-hover:bg-red-500/30 transition-all">
              <i class="fa-solid fa-file-pdf"></i>
            </div>
            <div class="grow min-w-0">
              <div class="text-sm font-semibold text-white group-hover:text-cyan-300 transition-colors flex items-center justify-between">
                <span>Descargar en PDF</span>
                <span class="text-[10px] uppercase font-bold bg-red-500/20 text-red-300 px-1.5 py-0.5 rounded">PDF</span>
              </div>
              <p class="text-xs text-gray-400 mt-0.5">Versión completa para PC (2 columnas)</p>
            </div>
          </a>

          <!-- Opción 2: DOCS Word Editable -->
          <a
            href="/cv_emerson_reyes.docx"
            download="CV_Emerson_Reyes.docx"
            class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition-colors group cursor-pointer text-left mt-1"
          >
            <div class="w-10 h-10 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center shrink-0 text-lg group-hover:scale-110 group-hover:bg-blue-500/30 transition-all">
              <i class="fa-solid fa-file-word"></i>
            </div>
            <div class="grow min-w-0">
              <div class="text-sm font-semibold text-white group-hover:text-cyan-300 transition-colors flex items-center justify-between">
                <span>Descargar en DOCS</span>
                <span class="text-[10px] uppercase font-bold bg-blue-500/20 text-blue-300 px-1.5 py-0.5 rounded">DOCX</span>
              </div>
              <p class="text-xs text-gray-400 mt-0.5">Formato editable Word / Google Docs</p>
            </div>
          </a>
        </div>
      </div>
    </div>
    
    <!-- CV Viewer -->
    <div class="grow w-full bg-white">
      <iframe src="/cv_emerson_reyes.html" class="w-full h-full border-0"></iframe>
    </div>
  </div>

  <script>
    const dropdownWrapper = document.getElementById('cv-dropdown-wrapper');
    const dropdownBtn = document.getElementById('cv-dropdown-btn');
    const dropdownMenu = document.getElementById('cv-dropdown-menu');
    const dropdownChevron = document.getElementById('cv-dropdown-chevron');

    let isOpen = false;

    function openDropdown() {
      isOpen = true;
      dropdownBtn?.setAttribute('aria-expanded', 'true');
      dropdownMenu?.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
      dropdownMenu?.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
      dropdownChevron?.classList.add('rotate-180');
    }

    function closeDropdown() {
      isOpen = false;
      dropdownBtn?.setAttribute('aria-expanded', 'false');
      dropdownMenu?.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
      dropdownMenu?.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
      dropdownChevron?.classList.remove('rotate-180');
    }

    dropdownBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    // Cerrar al hacer click en cualquier opción de descarga
    dropdownMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        closeDropdown();
      });
    });

    // Cerrar al hacer click fuera
    document.addEventListener('click', (e) => {
      if (!dropdownWrapper?.contains(e.target as Node)) {
        closeDropdown();
      }
    });

    // Cerrar con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeDropdown();
      }
    });
  </script>
</Layout>
