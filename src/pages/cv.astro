---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Curriculum Vitae - Emerson Reyes">
  <style is:global>
    /* Ocultar el navbar principal y cualquier botón flotante de whatsapp en esta vista */
    nav, #whatsapp-btn, #whatsapp-floating-btn, a[href*="wa.me"].fixed { 
      display: none !important; 
    }
    
    body {
      overflow: hidden;
    }

    /* Ocultar barras de scroll manteniendo la funcionalidad de scroll */
    * {
      scrollbar-width: none !important;
      -ms-overflow-style: none !important;
    }
    *::-webkit-scrollbar {
      display: none !important;
      width: 0 !important;
      height: 0 !important;
    }
  </style>

  <div class="h-screen w-screen flex flex-col lg:flex-row overflow-hidden bg-slate-100 dark:bg-[#07090e] text-slate-800 dark:text-white relative z-50 transition-colors duration-500">
    
    <!-- ═══ FONDO CON CÍRCULOS ILUMINADOS SUTILES EN MOVIMIENTO SUAVE ═══ -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
      <!-- Círculo 1: Azul Cyan suave detrás de la cabecera del CV -->
      <div class="cv-orb cv-orb-1 absolute -top-24 -left-24 w-125 h-125 rounded-full bg-cyan-400/12 dark:bg-cyan-500/10 blur-[110px]"></div>
      
      <!-- Círculo 2: Azul Cobalto sutil en la parte inferior izquierda -->
      <div class="cv-orb cv-orb-2 absolute -bottom-24 left-1/4 w-130 h-130 rounded-full bg-blue-500/10 dark:bg-blue-600/12 blur-[120px]"></div>
      
      <!-- Círculo 3: Acento suave en el centro -->
      <div class="cv-orb cv-orb-3 absolute top-1/3 left-1/2 -translate-x-1/2 w-100 h-100 rounded-full bg-indigo-400/8 dark:bg-indigo-500/8 blur-[110px]"></div>

      <!-- Círculo 4: Brillo sutil en la esquina superior derecha detrás de los paneles -->
      <div class="cv-orb cv-orb-4 absolute -top-16 -right-16 w-96 h-96 rounded-full bg-cyan-500/10 dark:bg-cyan-400/8 blur-[100px]"></div>
    </div>

    <!-- ═══ SECCIÓN IZQUIERDA: Visor del CV con scroll libre ═══ -->
    <div class="flex-1 h-full overflow-hidden relative flex flex-col z-10">
      <iframe 
        id="cvIframe"
        src="/cv_emerson_reyes.html" 
        class="w-full h-full border-0 bg-transparent"
        title="Curriculum Vitae Emerson Reyes"
      ></iframe>
    </div>

    <!-- ═══ SECCIÓN DERECHA: Los 3 Paneles Idénticos al Modal de GSAP (Fijos) ═══ -->
    <div class="cv-panels-column w-full lg:w-[530px] xl:w-[580px] shrink-0 h-auto lg:h-full p-2.5 sm:p-3.5 lg:p-4 flex flex-col gap-2.5 z-20 overflow-y-auto border-t lg:border-t-0 lg:border-l border-slate-300/60 dark:border-white/10 bg-slate-100/60 dark:bg-slate-950/60 backdrop-blur-xl lg:bg-transparent lg:backdrop-blur-none pointer-events-auto">
      
      <!-- 1. Panel Superior (skills-nav-top) -->
      <div class="skills-nav-panel skills-nav-top skills-nav-border" id="cvNavTop">
        <div class="flex items-start justify-between gap-4 pb-3 mb-3 border-b border-gray-200 dark:border-white/10">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-blue-500/10 text-blue-500 dark:text-blue-400 flex items-center justify-center text-2xl shrink-0 border border-blue-500/20 shadow-sm">
              <i class="fa-solid fa-user-tie"></i>
            </div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25">
                  Disponible
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
                  Full Stack
                </span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                Emerson Fabián Reyes
              </h3>
            </div>
          </div>

          <!-- THEME TOGGLE (Idéntico al Navbar) -->
          <button
            id="cv-theme-toggle"
            type="button"
            class="flex items-center justify-center w-9 h-9 rounded-full text-gray-500 dark:text-gray-300 hover:bg-gray-900/5 dark:hover:bg-white/5 hover:text-gray-900 dark:hover:text-white transition-all cursor-pointer shrink-0"
            aria-label="Cambiar tema"
          >
            <i id="cv-theme-icon" class="fa-solid fa-moon text-sm"></i>
          </button>
        </div>

        <!-- Resumen CV -->
        <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
          Desarrollador de Software Full Stack con más de 3 años de experiencia construyendo plataformas web y móviles escalables. Especializado en React, TypeScript, NestJS, Spring Boot, PostgreSQL y arquitecturas modernas con APIs REST.
        </p>

        <!-- Descarga de Formatos del CV -->
        <div class="mb-4">
          <div class="flex items-center gap-1.5 mb-2.5">
            <i class="fa-solid fa-file-arrow-down text-xs text-blue-500 dark:text-cyan-400"></i>
            <span class="text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300">
              Descarga directa del CV:
            </span>
          </div>
          
          <div class="relative w-full" id="cv-dropdown-wrapper">
            <button
              id="cv-dropdown-btn"
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
              class="w-full flex items-center justify-between px-4 py-3 rounded-2xl bg-gradient-to-r from-blue-600 via-indigo-600 to-cyan-500 text-white font-semibold text-xs sm:text-sm shadow-lg shadow-blue-500/25 hover:opacity-95 transition-all cursor-pointer"
            >
              <span class="flex items-center gap-2">
                <i class="fa-solid fa-download"></i>
                <span>Descargar CV Completo</span>
              </span>
              <i id="cv-dropdown-chevron" class="fa-solid fa-chevron-down text-xs transition-transform duration-200"></i>
            </button>

            <!-- Dropdown Menú -->
            <div
              id="cv-dropdown-menu"
              class="absolute left-0 right-0 bottom-full lg:bottom-auto lg:top-full mb-2 lg:mb-0 lg:mt-2 rounded-2xl bg-white/95 dark:bg-gray-900/98 backdrop-blur-2xl border border-slate-200 dark:border-white/15 shadow-2xl p-2 z-50 transition-all duration-200 opacity-0 pointer-events-none scale-95 origin-bottom lg:origin-top"
            >
              <div class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 border-b border-gray-100 dark:border-white/10 mb-1">
                Seleccionar Formato
              </div>
              <a
                href="/cv_emerson_reyes.pdf"
                download="CV_Emerson_Reyes.pdf"
                class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-blue-50 dark:hover:bg-white/10 transition-colors group cursor-pointer text-left"
              >
                <div class="w-9 h-9 rounded-lg bg-red-500/15 text-red-500 dark:bg-red-500/20 dark:text-red-400 flex items-center justify-center shrink-0 text-base group-hover:scale-105 transition-all">
                  <i class="fa-solid fa-file-pdf"></i>
                </div>
                <div class="grow min-w-0">
                  <div class="text-xs font-semibold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-cyan-300 transition-colors flex items-center justify-between">
                    <span>Descargar en PDF</span>
                    <span class="text-[9px] uppercase font-bold bg-red-500/15 text-red-600 dark:bg-red-500/20 dark:text-red-300 px-1.5 py-0.5 rounded">PC 2 Col</span>
                  </div>
                  <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">Versión completa diagramada para PC</p>
                </div>
              </a>
              <a
                href="/cv_emerson_reyes.docx"
                download="CV_Emerson_Reyes.docx"
                class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-blue-50 dark:hover:bg-white/10 transition-colors group cursor-pointer text-left mt-1"
              >
                <div class="w-9 h-9 rounded-lg bg-blue-500/15 text-blue-500 dark:bg-blue-500/20 dark:text-blue-400 flex items-center justify-center shrink-0 text-base group-hover:scale-105 transition-all">
                  <i class="fa-solid fa-file-word"></i>
                </div>
                <div class="grow min-w-0">
                  <div class="text-xs font-semibold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-cyan-300 transition-colors flex items-center justify-between">
                    <span>Descargar en DOCS</span>
                    <span class="text-[9px] uppercase font-bold bg-blue-500/15 text-blue-600 dark:bg-blue-500/20 dark:text-blue-300 px-1.5 py-0.5 rounded">Word</span>
                  </div>
                  <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">Editable para Word y Google Docs</p>
                </div>
              </a>
            </div>
          </div>
        </div>

        <div class="mt-auto pt-3 border-t border-gray-200/70 dark:border-white/10 flex items-center justify-between text-xs text-gray-400 font-mono">
          <span class="text-[11px] uppercase tracking-wider text-blue-600 dark:text-cyan-300/80">
            Full Stack Software Developer
          </span>
          <span class="text-[11px] text-slate-500 dark:text-gray-400">
            Emerson Reyes
          </span>
        </div>
      </div>

      <!-- 2. Panel Intermedio (skills-nav-middle) -->
      <div class="skills-nav-panel skills-nav-middle skills-nav-border" id="cvNavMiddle">
        <div class="skills-middle-header">
          {'{ APLICACIÓN PRÁCTICA & CONTACTO DIRECTO }'}
        </div>
        <div class="skills-middle-card">
          <div class="skills-middle-badge">
            <i class="fa-solid fa-address-card text-xl"></i>
          </div>
          <div class="skills-middle-info">
            <div class="skills-middle-title">
              Disponibilidad & Contacto Inmediato
            </div>
            <p class="skills-middle-desc">
              Disponible para contratación y proyectos remotos o presenciales. Canales directos de contacto:
            </p>
          </div>
        </div>
        <div class="skills-middle-actions flex-wrap">
          <a href="https://linkedin.com/in/emerson-reyes-97920a386" target="_blank" rel="noopener noreferrer" class="skills-action-btn primary cursor-pointer">
            <i class="fa-brands fa-linkedin mr-1.5"></i> LinkedIn
          </a>
          <a href="https://github.com/152004E" target="_blank" rel="noopener noreferrer" class="skills-action-btn cursor-pointer">
            <i class="fa-brands fa-github mr-1.5"></i> GitHub
          </a>
          <a href="mailto:reyesemerson643@gmail.com" class="skills-action-btn cursor-pointer">
            <i class="fa-solid fa-envelope mr-1.5"></i> Email
          </a>
          <a href="tel:+573222463385" class="skills-action-btn cursor-pointer">
            <i class="fa-solid fa-phone mr-1.5"></i> +57 322 246 3385
          </a>
        </div>
      </div>

      <!-- 3. Panel Inferior (skills-nav-bottom) -->
      <div class="skills-nav-panel skills-nav-bottom skills-nav-border" id="cvNavBottom">
        <ul class="skills-socials">
          <li><a href="https://github.com/152004E" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-github mr-1.5"></i>GitHub</a></li>
          <li><a href="https://linkedin.com/in/emerson-reyes-97920a386" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-linkedin mr-1.5"></i>LinkedIn</a></li>
          <li><a href="/" class="text-blue-600 dark:text-cyan-400 hover:text-blue-700 dark:hover:text-cyan-300 font-semibold"><i class="fa-solid fa-arrow-left mr-1.5"></i>Volver</a></li>
        </ul>
        <div class="skills-nav-asset flex items-center">
          <a 
            href="https://wa.me/573222463385?text=%C2%A1Hola!%20Me%20gustar%C3%ADa%20hablar%20sobre%20tu%20CV%20y%20proyectos." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500 hover:bg-emerald-400 text-white font-semibold text-xs transition-all hover:scale-105 shadow-md shadow-emerald-500/25 cursor-pointer"
          >
            <i class="fa-brands fa-whatsapp text-sm"></i>
            <span>Escribir al WhatsApp</span>
          </a>
        </div>
      </div>

    </div>
  </div>

  <style>
    /* ── Animación suave de los orbes luminosos en el fondo ── */
    @keyframes cv-float-1 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(25px, 20px) scale(1.04); }
    }
    @keyframes cv-float-2 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(-20px, -25px) scale(0.97); }
    }
    @keyframes cv-float-3 {
      0%, 100% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(18px, -18px) scale(1.03); }
    }
    .cv-orb-1 { animation: cv-float-1 24s ease-in-out infinite; }
    .cv-orb-2 { animation: cv-float-2 28s ease-in-out infinite; }
    .cv-orb-3 { animation: cv-float-3 22s ease-in-out infinite; }
    .cv-orb-4 { animation: cv-float-1 25s ease-in-out infinite reverse; }

    /* ── Estilos Exactos del Modal de GSAP (GreenSock Style) ── */
    .skills-nav-border {
      border-radius: 28px;
      border: 1px solid;
    }
    .skills-nav-panel {
      width: 100%;
    }
    .skills-nav-top {
      flex: 1;
      width: 100%;
      background: #ffffff;
      color: #0e100f;
      display: flex;
      flex-direction: column;
      padding: 24px 28px 20px;
      overflow-y: auto;
      position: relative;
      border-color: rgba(0, 0, 0, 0.12);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
    }
    :global(.dark) .skills-nav-top {
      background: #0d1117;
      color: #ffffff;
      border-color: rgba(255, 255, 255, 0.12);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.35);
    }
    .skills-nav-middle {
      position: relative;
      width: 100%;
      background: linear-gradient(
        135deg,
        #f0f7ff 0%,
        #e0f2fe 50%,
        #eef2ff 100%
      );
      color: #0f172a;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 20px 24px;
      border-color: rgba(59, 130, 246, 0.3);
      min-height: 140px;
      box-shadow: 0 10px 30px rgba(59, 130, 246, 0.1);
    }
    :global(.dark) .skills-nav-middle {
      background: linear-gradient(
        135deg,
        #0b1329 0%,
        #0f172a 55%,
        #082f49 100%
      );
      color: #ffffff;
      border-color: rgba(56, 189, 248, 0.3);
      box-shadow: 0 10px 30px rgba(56, 189, 248, 0.12);
    }
    .skills-middle-header {
      font-family: monospace;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 10px;
      color: #2563eb;
    }
    :global(.dark) .skills-middle-header {
      color: #38bdf8;
    }
    .skills-middle-card {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .skills-middle-badge {
      flex-shrink: 0;
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: rgba(59, 130, 246, 0.12);
      color: #2563eb;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(59, 130, 246, 0.2);
    }
    :global(.dark) .skills-middle-badge {
      background: rgba(56, 189, 248, 0.15);
      color: #38bdf8;
      border-color: rgba(56, 189, 248, 0.3);
    }
    .skills-middle-info {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .skills-middle-title {
      font-weight: 700;
      font-size: clamp(1rem, 3vw, 1.25rem);
      line-height: 1.2;
      letter-spacing: -0.02em;
      color: #0f172a;
    }
    :global(.dark) .skills-middle-title {
      color: #ffffff;
    }
    .skills-middle-desc {
      font-size: 0.8rem;
      color: #334155;
      line-height: 1.4;
    }
    :global(.dark) .skills-middle-desc {
      color: #cbd5e1;
    }
    .skills-middle-actions {
      display: flex;
      gap: 10px;
      margin-top: 14px;
    }
    .skills-action-btn {
      font-family: monospace;
      font-size: 0.75rem;
      font-weight: 600;
      text-decoration: none;
      color: #1e3a8a;
      padding: 6px 14px;
      border-radius: 100px;
      background: rgba(59, 130, 246, 0.08);
      border: 1px solid rgba(59, 130, 246, 0.2);
      display: inline-flex;
      align-items: center;
      transition: all 0.2s;
    }
    :global(.dark) .skills-action-btn {
      color: #e2e8f0;
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.15);
    }
    .skills-action-btn:hover {
      background: rgba(59, 130, 246, 0.15);
      transform: translateY(-1px);
    }
    :global(.dark) .skills-action-btn:hover {
      background: rgba(255, 255, 255, 0.12);
    }
    .skills-action-btn.primary {
      background: #2563eb;
      color: #ffffff;
      border-color: #2563eb;
    }
    .skills-action-btn.primary:hover {
      background: #1d4ed8;
      color: #ffffff;
    }
    :global(.dark) .skills-action-btn.primary {
      background: linear-gradient(to right, #2563eb, #06b6d4);
      color: #ffffff;
      border-color: transparent;
    }
    :global(.dark) .skills-action-btn.primary:hover {
      background: linear-gradient(to right, #1d4ed8, #0891b2);
    }
    .skills-nav-bottom {
      position: relative;
      width: 100%;
      background: #ffffff;
      color: #475569;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 24px;
      border-color: rgba(0, 0, 0, 0.12);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }
    :global(.dark) .skills-nav-bottom {
      background: #0d1117;
      color: #909491;
      border-color: rgba(255, 255, 255, 0.12);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }
    .skills-socials {
      display: flex;
      gap: 16px;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .skills-socials a {
      color: #475569;
      text-decoration: none;
      font-size: 0.75rem;
      font-family: monospace;
      transition: color 0.2s;
      display: inline-flex;
      align-items: center;
    }
    :global(.dark) .skills-socials a {
      color: #8b949e;
    }
    .skills-socials a:hover {
      color: #2563eb;
    }
    :global(.dark) .skills-socials a:hover {
      color: #58a6ff;
    }
  </style>

  <script>
    import { gsap } from 'gsap';

    // ═══ THEME TOGGLE (Idéntico al Navbar con animación circular ripple) ═══
    const cvThemeToggle = document.getElementById("cv-theme-toggle");
    const cvThemeIcon = document.getElementById("cv-theme-icon");
    const cvIframe = document.getElementById("cvIframe") as HTMLIFrameElement;

    function syncIframeTheme(isDark: boolean) {
      try {
        if (cvIframe && cvIframe.contentDocument) {
          if (isDark) {
            cvIframe.contentDocument.documentElement.classList.add("dark");
          } else {
            cvIframe.contentDocument.documentElement.classList.remove("dark");
          }
        }
      } catch (e) {}
    }

    cvIframe?.addEventListener("load", () => {
      syncIframeTheme(document.documentElement.classList.contains("dark"));
    });

    function updateCvThemeUI(isDark: boolean) {
      const iconClass = isDark ? "fa-sun" : "fa-moon";
      if (cvThemeIcon) {
        cvThemeIcon.className = `fa-solid ${iconClass} text-sm`;
      }
      syncIframeTheme(isDark);
    }

    function toggleCvTheme(event: MouseEvent) {
      const x = event.clientX;
      const y = event.clientY;

      const endRadius = Math.hypot(
        Math.max(x, innerWidth - x),
        Math.max(y, innerHeight - y)
      );

      if (!(document as any).startViewTransition) {
        document.documentElement.classList.toggle("dark");
        const isDark = document.documentElement.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
        updateCvThemeUI(isDark);
        return;
      }

      const transition = (document as any).startViewTransition(() => {
        document.documentElement.classList.toggle("dark");
        const isDark = document.documentElement.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
        updateCvThemeUI(isDark);
      });

      transition.ready.then(() => {
        document.documentElement.animate(
          {
            clipPath: [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${endRadius}px at ${x}px ${y}px)`
            ]
          },
          {
            duration: 700,
            easing: "ease-in-out",
            pseudoElement: "::view-transition-new(root)"
          }
        );
      });
    }

    if (cvThemeToggle) {
      cvThemeToggle.addEventListener("click", toggleCvTheme);
    }
    updateCvThemeUI(document.documentElement.classList.contains("dark"));

    // ═══ Animación de Entrada GSAP: Uno por uno de izquierda a derecha (Stagger) ═══
    window.addEventListener('DOMContentLoaded', () => {
      gsap.fromTo(
        '.skills-nav-panel',
        {
          x: '-110%',
          opacity: 0,
        },
        {
          x: '0%',
          opacity: 1,
          duration: 0.65,
          ease: 'back.out',
          stagger: 0.12,
          delay: 0.1,
          clearProps: 'transform',
        }
      );
    });

    // ═══ Dropdown Modal de Descarga ═══
    const dropdownWrapper = document.getElementById('cv-dropdown-wrapper');
    const dropdownBtn = document.getElementById('cv-dropdown-btn');
    const dropdownMenu = document.getElementById('cv-dropdown-menu');
    const dropdownChevron = document.getElementById('cv-dropdown-chevron');

    let isOpen = false;

    function openDropdown() {
      isOpen = true;
      dropdownBtn?.setAttribute('aria-expanded', 'true');
      dropdownMenu?.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
      dropdownMenu?.classList.add('opacity-100', 'pointer-events-auto', 'scale-100');
      dropdownChevron?.classList.add('rotate-180');
    }

    function closeDropdown() {
      isOpen = false;
      dropdownBtn?.setAttribute('aria-expanded', 'false');
      dropdownMenu?.classList.remove('opacity-100', 'pointer-events-auto', 'scale-100');
      dropdownMenu?.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
      dropdownChevron?.classList.remove('rotate-180');
    }

    dropdownBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    // Cerrar al hacer click en cualquier opción de descarga
    dropdownMenu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        closeDropdown();
      });
    });

    document.addEventListener('click', (e) => {
      if (isOpen && dropdownWrapper && !dropdownWrapper.contains(e.target as Node)) {
        closeDropdown();
      }
    });

    // Cerrar con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeDropdown();
      }
    });
  </script>
</Layout>
