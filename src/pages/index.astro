---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Projects from '../components/Projects.astro';
import Experience from '../components/Experience.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---


<Layout>
  <main class="overflow-x-hidden">
    <div id="panels-source" style="display: none;">
      <div data-id="hero" class="gsap-horizontal-panel w-screen shrink-0"><Hero /></div>
      <div data-id="about" class="gsap-horizontal-panel w-screen shrink-0 flex items-center"><About /></div>
      <div data-id="projects" class="gsap-horizontal-panel w-screen min-h-screen shrink-0 flex items-center justify-center"><div class="w-full"><Projects /></div></div>
      <div data-id="skills" class="gsap-horizontal-panel w-screen min-h-screen shrink-0 flex items-center justify-center"><div class="w-full"><Services /></div></div>
      <div data-id="experience" class="gsap-horizontal-panel w-screen min-h-screen shrink-0 flex items-center justify-center"><div class="w-full"><Experience /></div></div>
      <div data-id="contact" class="gsap-horizontal-panel w-screen h-screen overflow-hidden shrink-0 flex flex-col justify-between"><div class="w-full grow flex items-center justify-center"><ContactForm /></div><div class="w-full shrink-0"><Footer /></div></div>
    </div>
    
    <div id="dynamic-cinematic-container"></div>
    
    <script is:inline>
      (function() {
        const patterns = [
          [
            { dir: 'ltr', panels: ['hero', 'about'] },
            { dir: 'rtl', panels: ['projects', 'skills'] },
            { dir: 'ltr', panels: ['experience', 'contact'] }
          ],
          [
            { dir: 'rtl', panels: ['about', 'hero'] },
            { dir: 'ltr', panels: ['skills', 'projects'] },
            { dir: 'rtl', panels: ['contact', 'experience'] }
          ],
          [
            { dir: 'none', panels: ['hero'] },
            { dir: 'rtl', panels: ['skills', 'about'] },
            { dir: 'rtl', panels: ['experience', 'projects'] },
            { dir: 'none', panels: ['contact'] }
          ],
          [
            { dir: 'none', panels: ['hero'] },
            { dir: 'ltr', panels: ['about', 'skills'] },
            { dir: 'ltr', panels: ['projects', 'experience'] },
            { dir: 'none', panels: ['contact'] }
          ]
        ];

        let usedPatterns = [];
        try {
          usedPatterns = JSON.parse(localStorage.getItem('used-snakes') || '[]');
        } catch(e) {}
        
        if (usedPatterns.length >= patterns.length) {
            usedPatterns = [];
        }

        const availablePatterns = [0, 1, 2, 3].filter(i => !usedPatterns.includes(i));
        const selectedIndex = availablePatterns[Math.floor(Math.random() * availablePatterns.length)];

        usedPatterns.push(selectedIndex);
        try {
          localStorage.setItem('used-snakes', JSON.stringify(usedPatterns));
        } catch(e) {}

        const pattern = patterns[selectedIndex];
        
        const source = document.getElementById('panels-source');
        const container = document.getElementById('dynamic-cinematic-container');
        if (!source || !container) return;
        
        const panelsMap = {};
        Array.from(source.children).forEach(p => {
            panelsMap[p.getAttribute('data-id')] = p;
        });
        
        pattern.forEach(group => {
            if (group.dir === 'none') {
               group.panels.forEach(pid => {
                  container.appendChild(panelsMap[pid]);
               });
            } else {
               const wrapper = document.createElement('div');
               wrapper.className = 'gsap-horizontal-wrapper w-full';
               wrapper.setAttribute('data-direction', group.dir);
               
               const inner = document.createElement('div');
               inner.className = 'gsap-horizontal-container flex flex-col w-full';
               
               group.panels.forEach(pid => {
                  inner.appendChild(panelsMap[pid]);
               });
               
               wrapper.appendChild(inner);
               container.appendChild(wrapper);
            }
        });
        
        source.remove();
      })();
    </script>
  </main>
</Layout>
