---
import '../styles/tailwind.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
import Navbar from '../components/Navbar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

interface Props {
	title?: string;
}

const { title = lang === 'es' ? "Emerson Reyes - Portafolio profesional" : "Emerson Reyes - Professional Portfolio" } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth" style="scroll-padding-top: 80px;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Agregar el Favicon-->
    <link rel="shortcut icon" href="/images/LogoCvOP-modifiedCirculo.png" type="image/png" />

    <!-- Google fonts-->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
      rel="stylesheet"
    />

    <!-- Transicion (Animate.css) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
    />

    <!-- AOS CSS -->
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />

    <style>
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }

      ::view-transition-new(root) {
        z-index: 9999;
      }

      ::view-transition-old(root) {
        z-index: 1;
      }

      html:not(.cinematic-enabled) .cinematic-spacer {
        display: none !important;
      }

      @keyframes float-orb-1 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        25% { transform: translate(40px, -30px) scale(1.05); }
        50% { transform: translate(-20px, 40px) scale(0.95); }
        75% { transform: translate(30px, 20px) scale(1.02); }
      }
      @keyframes float-orb-2 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        25% { transform: translate(-35px, 25px) scale(0.97); }
        50% { transform: translate(25px, -35px) scale(1.06); }
        75% { transform: translate(-15px, -25px) scale(1.03); }
      }
      @keyframes float-orb-3 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33% { transform: translate(30px, 35px) scale(1.04); }
        66% { transform: translate(-25px, -20px) scale(0.96); }
      }
      .animate-float-orb-1 { animation: float-orb-1 25s ease-in-out infinite; }
      .animate-float-orb-2 { animation: float-orb-2 30s ease-in-out infinite; }
      .animate-float-orb-3 { animation: float-orb-3 20s ease-in-out infinite; }
    </style>

    <script is:inline>
      (function() {
        if (localStorage.getItem("theme") === "dark") {
          document.documentElement.classList.add("dark");
        }
        
        // Cinematic mode default to false (Modo Plano por defecto)
        const cinematicPref = localStorage.getItem("cinematic-mode");
        if (cinematicPref === "true") {
          document.documentElement.classList.add("cinematic-enabled");
        }
      })();
    </script>
  </head>
  <body class="text-gray-900 dark:text-white antialiased relative">
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
      <div class="absolute -top-48 -left-48 w-125 h-125 bg-blue-500/20 dark:bg-blue-500/40 rounded-full blur-[120px] animate-float-orb-1"></div>
      <div class="absolute top-1/3 -right-48 w-100 h-100 bg-cyan-500/15 dark:bg-cyan-500/35 rounded-full blur-[100px] animate-float-orb-2"></div>
      <div class="absolute -bottom-32 left-1/4 w-112.5 h-112.5 bg-blue-600/15 dark:bg-blue-600/35 rounded-full blur-[110px] animate-float-orb-3"></div>
      <div class="absolute top-2/3 left-1/2 w-87.5 h-87.5 bg-cyan-400/15 dark:bg-cyan-400/30 rounded-full blur-[90px] animate-float-orb-1"></div>
      <div class="absolute top-1/4 left-1/3 w-75 h-75 bg-blue-400/15 dark:bg-blue-400/30 rounded-full blur-[80px] animate-float-orb-2" style="animation-delay: -5s"></div>
    </div>
    <Navbar />
    <div class="relative z-10">
      <slot />
    </div>
    <WhatsAppButton />

    <!-- AOS JS -->
    <script is:inline src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script is:inline>
      AOS.init({
        duration: 500, // Duración en milisegundos (0.5s)
        once: true, // Solo una vez por scroll
      });
    </script>

    <!-- GSAP & Lenis Setup -->
    <script>
      import Lenis from 'lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      let lenis: any;
      let ctx: any;
      let navLinksHandler: any;

      function initNavigationAndScroll() {
        if (window.location.pathname.includes('/cv')) return;

        const isCinematic = document.documentElement.classList.contains('cinematic-enabled');

        lenis = new Lenis({
          duration: isCinematic ? 0.4 : 0.8,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
          wheelMultiplier: isCinematic ? 1.8 : 1.0,
        });

        lenis.on('scroll', ScrollTrigger.update);

        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });
        gsap.ticker.lagSmoothing(0);

        navLinksHandler = (e: Event) => {
          const targetId = (e.currentTarget as Element).getAttribute('href');
          if (targetId && targetId.startsWith('#') && document.querySelector(targetId)) {
             e.preventDefault();
             
             if (targetId === '#section-portada') {
               lenis.scrollTo(0, { duration: 0.8 });
               return;
             }
             
             const targetEl = document.querySelector(targetId);
             if (!targetEl) return;
             
             if (isCinematic) {
               const wrapper = targetEl.closest('.gsap-horizontal-wrapper');
               if (wrapper) {
                  const trigger = ScrollTrigger.getAll().find(t => t.trigger === wrapper);
                  if (trigger) {
                     const container = wrapper.querySelector('.gsap-horizontal-container');
                     if (container) {
                         const panels = Array.from(container.querySelectorAll('.gsap-horizontal-panel'));
                         const panel = targetEl.closest('.gsap-horizontal-panel');
                         if (panel) {
                             const panelIndex = panels.indexOf(panel);
                             const direction = wrapper.getAttribute('data-direction');
                             
                             let progress = 0;
                             if (panels.length > 1) {
                                if (direction === 'rtl') {
                                   const visualIndex = panels.length - 1 - panelIndex;
                                   progress = visualIndex / (panels.length - 1);
                                } else {
                                   progress = panelIndex / (panels.length - 1);
                                }
                             }
                             
                             const scrollPos = trigger.start + (trigger.end - trigger.start) * progress;
                             lenis.scrollTo(scrollPos, { duration: 1.0 });
                             return;
                         }
                     }
                  }
               }
             }
             
             lenis.scrollTo(targetEl, { offset: -70, duration: 0.8 });
          }
        };
        
        document.querySelectorAll('nav a[href^="#"], a[href^="#contacto"], a[href^="#section-proyectos"]').forEach(anchor => {
          anchor.addEventListener('click', navLinksHandler);
        });

        if (isCinematic) {
          // Use context for easy cleanup
          ctx = gsap.context(() => {
            const wrappers = document.querySelectorAll('.gsap-horizontal-wrapper');
            wrappers.forEach(wrapper => {
              const container = wrapper.querySelector('.gsap-horizontal-container');
              if (!container) return;
              const panels = gsap.utils.toArray(container.querySelectorAll('.gsap-horizontal-panel'));
              const direction = wrapper.getAttribute('data-direction') || 'ltr';

              if (panels.length > 0) {
                container.classList.remove('flex-col');
                container.setAttribute('style', `display: flex; flex-direction: row; width: ${panels.length * 100}vw;`);

                if (direction === 'rtl') {
                  gsap.set(panels, { xPercent: -100 * (panels.length - 1) });
                  gsap.to(panels, {
                    xPercent: 0,
                    ease: "none",
                    scrollTrigger: {
                      trigger: wrapper,
                      pin: true,
                      scrub: true,
                      end: () => "+=" + (container.getBoundingClientRect().width * 0.4)
                    }
                  });
                } else {
                  gsap.to(panels, {
                    xPercent: -100 * (panels.length - 1),
                    ease: "none",
                    scrollTrigger: {
                      trigger: wrapper,
                      pin: true,
                      scrub: true,
                      end: () => "+=" + (container.getBoundingClientRect().width * 0.4)
                    }
                  });
                }
              }
            });
          });
        }
      }

      function destroyCinematic() {
        if (ctx) ctx.revert();
        
        if (lenis) {
          lenis.destroy();
          gsap.ticker.remove(lenis.raf);
        }

        if (navLinksHandler) {
          document.querySelectorAll('nav a[href^="#"]').forEach(anchor => {
            anchor.removeEventListener('click', navLinksHandler);
          });
        }
        
        // Restore flex layout
        const containers = document.querySelectorAll('.gsap-horizontal-container');
        containers.forEach(container => {
          container.removeAttribute('style');
          container.classList.add('flex-col');
        });
      }

      // Initialize
      initNavigationAndScroll();



      // Curve Swipe Transition
      const svg = document.getElementById("curve-swipe-svg");
      const path = document.getElementById("curve-swipe-path");
      
      if (svg && path) {
        const inStart = "M 0 100 V 100 Q 50 100 100 100 V 100 z";
        const inMid   = "M 0 100 V 50 Q 50 0 100 50 V 100 z";
        const inEnd   = "M 0 100 V 0 Q 50 0 100 0 V 100 z";
        
        const outStart = "M 0 0 V 100 Q 50 100 100 100 V 0 z";
        const outMid   = "M 0 0 V 50 Q 50 0 100 50 V 0 z";
        const outEnd   = "M 0 0 V 0 Q 50 0 100 0 V 0 z";

        if (sessionStorage.getItem("curve-transition") === "true") {
           sessionStorage.removeItem("curve-transition");
           svg.style.display = "block";
           svg.style.pointerEvents = "auto";
           path.setAttribute("d", outStart);
           
           setTimeout(() => {
               gsap.to(path, {
                   duration: 0.55,
                   attr: { d: outMid },
                   ease: "power2.in",
                   onComplete: () => {
                       gsap.to(path, {
                           duration: 0.55,
                           attr: { d: outEnd },
                           ease: "power2.out",
                           onComplete: () => {
                               svg.style.display = "none";
                               svg.style.pointerEvents = "none";
                           }
                       });
                   }
               });
           }, 400);
        }

        document.querySelectorAll('.curve-transition-link').forEach(link => {
           link.addEventListener('click', (e) => {
               e.preventDefault();
               const targetUrl = link.getAttribute('href');
               if (!targetUrl) return;
               
               svg.style.display = "block";
               svg.style.pointerEvents = "auto";
               path.setAttribute("d", inStart);
               
               gsap.to(path, {
                   duration: 0.55,
                   attr: { d: inMid },
                   ease: "power2.in",
                   onComplete: () => {
                       gsap.to(path, {
                           duration: 0.55,
                           attr: { d: inEnd },
                           ease: "power2.out",
                           onComplete: () => {
                               sessionStorage.setItem("curve-transition", "true");
                               setTimeout(() => {
                                   window.location.href = targetUrl;
                               }, 150);
                           }
                       });
                   }
               });
           });
        });
      }
    </script>
    
    <!-- Curve Swipe SVG Overlay -->
    <svg id="curve-swipe-svg" viewBox="0 0 100 100" preserveAspectRatio="none" class="fixed inset-0 w-full h-full pointer-events-none z-99999" style="display: none;">
      <path id="curve-swipe-path" fill="#1e1b4b" d="M 0 100 V 100 Q 50 100 100 100 V 100 z" />
    </svg>
  </body>
</html>
