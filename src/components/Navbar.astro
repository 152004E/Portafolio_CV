---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
  { href: "#section-portada", label: t('nav.home') },
  { href: "#sobre-mi", label: t('nav.about') },
  { href: "#section-proyectos", label: t('nav.projects') },
  { href: "#section-experiencia", label: t('nav.experience') },

];

const currentLangLabel = {
  es: '🇨🇴 Español',
  en: '🇺🇸 English'
}[lang];
---


<nav class="fixed top-5 left-1/2 -translate-x-1/2 z-50 w-full px-4">
  <div
    class="
      mx-auto
      w-fit
      flex
      items-center
      gap-2
      rounded-full
      border border-gray-200/60 dark:border-white/10
      bg-white/70 dark:bg-black/60
      backdrop-blur-2xl
      px-3
      py-2
      shadow-[0_0_40px_rgba(59,130,246,0.08)]
    "
  >

    <!-- LOGO -->
    <a
      href="#section-portada"
      class="
        hidden md:flex
        items-center
        gap-1
        pr-3
        border-r
        border-gray-200 dark:border-white/10
        text-sm
        font-semibold
        text-gray-800 dark:text-white
        tracking-wide
      "
    >
      <span class="text-blue-400">&lt;</span>
      Emerson
      <span class="text-cyan-400">/&gt;</span>
    </a>

    <!-- DESKTOP NAV -->
    <div class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="
            nav-link
            group
            relative
            px-4
            py-2
            text-sm
            text-gray-500 dark:text-gray-300
            transition-all
            duration-300
            hover:text-gray-900 dark:hover:text-white
            [&.active]:text-gray-900 dark:[&.active]:text-white
          "
        >
          <span class="relative z-10">{link.label}</span>

          <!-- Hover Background -->
          <span
            class="
              absolute
              inset-0
              rounded-full
              bg-gray-900/4 dark:bg-white/4
              opacity-0
              transition-all
              duration-300
              group-hover:opacity-100
              group-[.active]:opacity-100
            "
          ></span>

          <!-- Glow Line -->
          <span
            class="
              nav-glow
              absolute
              bottom-0
              left-1/2
              h-0.5
              w-0
              -translate-x-1/2
              rounded-full
              bg-linear-to-r
              from-blue-500
              to-cyan-400
              transition-all
              duration-300
              group-hover:w-3/4
              group-[.active]:w-3/4
            "
          ></span>
        </a>
      ))}
    </div>

    <!-- RIGHT ACTIONS -->
    <div class="hidden md:flex items-center gap-2 pl-2 border-l border-gray-200 dark:border-white/10">

      <!-- LANGUAGE DROPDOWN -->
      <div class="relative group">
        <button
          class="
            flex
            items-center
            gap-2
            rounded-full
            px-3
            py-2
            text-sm
            text-gray-500 dark:text-gray-300
            hover:bg-gray-900/4 dark:hover:bg-white/5
            hover:text-gray-900 dark:hover:text-white
            transition-all
          "
        >
          {currentLangLabel} <i class="fa-solid fa-chevron-down text-[10px] ml-1 opacity-70"></i>
        </button>

        <!-- Dropdown Menu -->
        <div
          class="
            absolute
            right-0
            top-full
            mt-2
            w-40
            rounded-2xl
            border border-gray-200/60 dark:border-white/10
            bg-white/90 dark:bg-black/90
            backdrop-blur-xl
            p-2
            shadow-xl
            opacity-0
            invisible
            group-hover:opacity-100
            group-hover:visible
            transition-all
            duration-300
            z-50
          "
        >
          <div class="flex flex-col gap-1">
            <!-- Español -->
            <a href="/" class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-white/5 transition-all">
              <span class="font-medium">🇨🇴 Español</span>
            </a>
            <!-- Inglés -->
            <a href="/en" class="flex items-center gap-2 rounded-xl px-3 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-white/5 transition-all">
              <span class="font-medium">🇺🇸 Inglés</span>
            </a>
            
          </div>
        </div>
      </div>

      <!-- STATUS -->
      <div
        class="
          flex
          items-center
          gap-2
          rounded-full
          border
          border-emerald-500/20
          bg-emerald-500/10
          px-3
          py-2
          text-xs
          font-medium
          text-emerald-400
        "
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
        </span>

        {t('nav.available')}
      </div>

      <!-- DOWNLOAD CV -->
      <a
        href={lang === 'es' ? "/cv_emerson_reyes.html" : "/cv_emerson_reyes_en.html"}
        download
        class="
          flex
          items-center
          gap-2
          rounded-full
          bg-linear-to-r
          from-blue-600
          to-cyan-500
          px-4
          py-2
          text-sm
          font-semibold
          text-white
          transition-all
          duration-300
          hover:scale-105
          hover:shadow-lg
          hover:shadow-blue-500/25
        "
      >
        <i class="fa-solid fa-download"></i>
        {t('nav.downloadCV')}
      </a>

      <!-- ANIMATION TOGGLE -->
      <button id="anim-toggle"
        class="
          flex
          items-center
          justify-center
          w-9
          h-9
          rounded-full
          text-gray-500 dark:text-gray-300
          hover:bg-gray-900/4 dark:hover:bg-white/5
          hover:text-gray-900 dark:hover:text-white
          transition-all
        "
        title="Modo Cinemático"
      >
        <i id="anim-icon" class="fa-solid fa-wand-magic-sparkles text-sm text-blue-500"></i>
      </button>

      <!-- THEME TOGGLE -->
      <button id="theme-toggle"
        class="
          flex
          items-center
          justify-center
          w-9
          h-9
          rounded-full
          text-gray-500 dark:text-gray-300
          hover:bg-gray-900/4 dark:hover:bg-white/5
          hover:text-gray-900 dark:hover:text-white
          transition-all
        "
        aria-label="Cambiar tema"
      >
        <i id="theme-icon" class="fa-solid fa-moon text-sm"></i>
      </button>
    </div>

    <!-- MOBILE BUTTON -->
    <button
      id="menu-toggle"
      class="
        md:hidden
        flex
        items-center
        justify-center
        w-10
        h-10
        rounded-full
        text-gray-700 dark:text-white
        hover:bg-gray-900/5 dark:hover:bg-white/5
        transition-all
      "
    >
      <i id="menu-icon" class="fa-solid fa-bars text-lg"></i>
    </button>
  </div>

  <!-- MOBILE MENU -->
  <div
    id="mobile-menu"
    class="
      hidden
      md:hidden
      mt-3
      rounded-3xl
      border
      border-gray-200/60 dark:border-white/10
      bg-white/90 dark:bg-black/80
      backdrop-blur-2xl
      p-4
      shadow-2xl
    "
  >
    <div class="flex flex-col gap-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="
            nav-link
            rounded-xl
            px-4
            py-3
            text-sm
            text-gray-500 dark:text-gray-300
            transition-all
            duration-300
            hover:bg-gray-900/4 dark:hover:bg-white/4
            hover:text-gray-900 dark:hover:text-white
            [&.active]:bg-gray-900/4 dark:[&.active]:bg-white/4
            [&.active]:text-gray-900 dark:[&.active]:text-white
            [&.active]:font-semibold
          "
        >
          {link.label}
        </a>
      ))}

      <!-- Languages Mobile -->
      <div class="flex flex-col gap-1 py-2 my-1 border-y border-gray-200/60 dark:border-white/10">
        <span class="px-4 text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-1">{t('nav.languages')}</span>
        <a href="/" class="flex items-center gap-2 rounded-xl px-4 py-3 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-white/5 transition-all">
          🇨🇴 Español
        </a>
        <a href="/en" class="flex items-center gap-2 rounded-xl px-4 py-3 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-white/5 transition-all">
          🇺🇸 Inglés
        </a>
        
      </div>

      <a
        href="#contacto"
        class="
          rounded-xl
          bg-linear-to-r
          from-blue-600
          to-cyan-500
          px-4
          py-3
          text-center
          text-sm
          font-semibold
          text-white
          transition-all
          duration-300
          hover:scale-[1.02]
        "
      >
        {t('nav.contact')}
      </a>

      <a
        href={lang === 'es' ? "/cv_emerson_reyes.html" : "/cv_emerson_reyes_en.html"}
        download
        class="
          rounded-xl
          border
          border-gray-200/60 dark:border-white/10
          bg-gray-100/50 dark:bg-white/3
          px-4
          py-3
          text-center
          text-sm
          font-semibold
          text-gray-700 dark:text-white
          transition-all
          duration-300
          hover:bg-gray-200/50 dark:hover:bg-white/8
        "
      >
        <i class="fa-solid fa-download"></i>
        {t('nav.downloadCV')}
      </a>

      <button
        id="anim-toggle-mobile"
        class="
          rounded-xl
          border
          border-gray-200/60 dark:border-white/10
          bg-gray-100/50 dark:bg-white/3
          px-4
          py-3
          text-center
          text-sm
          font-semibold
          text-gray-500 dark:text-gray-300
          transition-all
          duration-300
          hover:bg-gray-200/50 dark:hover:bg-white/8
          hover:text-gray-900 dark:hover:text-white
        "
      >
        <i id="anim-icon-mobile" class="fa-solid fa-wand-magic-sparkles text-blue-500"></i>
        <span class="ml-2">Modo Cinemático</span>
      </button>

      <button
        id="theme-toggle-mobile"
        class="
          rounded-xl
          border
          border-gray-200/60 dark:border-white/10
          bg-gray-100/50 dark:bg-white/3
          px-4
          py-3
          text-center
          text-sm
          font-semibold
          text-gray-500 dark:text-gray-300
          transition-all
          duration-300
          hover:bg-gray-200/50 dark:hover:bg-white/8
          hover:text-gray-900 dark:hover:text-white
        "
      >
        <i id="theme-icon-mobile" class="fa-solid fa-moon"></i>
        <span class="ml-2">{t('nav.darkmode')}</span>
      </button>
    </div>
  </div>
</nav>

<script define:vars={{ lightText: t('nav.lightmode'), darkText: t('nav.darkmode') }}>
  const menuToggle = document.getElementById("menu-toggle");
  const menuIcon = document.getElementById("menu-icon");
  const mobileMenu = document.getElementById("mobile-menu");

  if (menuToggle && menuIcon && mobileMenu) {
    menuToggle.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");

      menuIcon.classList.toggle("fa-bars");
      menuIcon.classList.toggle("fa-times");
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");

        menuIcon.classList.add("fa-bars");
        menuIcon.classList.remove("fa-times");
      });
    });
  }

  const themeIcon = document.getElementById("theme-icon");
  const themeIconMobile = document.getElementById("theme-icon-mobile");
  const themeToggleMobile = document.getElementById("theme-toggle-mobile");
  const themeToggle = document.getElementById("theme-toggle");

  const animIcon = document.getElementById("anim-icon");
  const animIconMobile = document.getElementById("anim-icon-mobile");
  const animToggleMobile = document.getElementById("anim-toggle-mobile");
  const animToggle = document.getElementById("anim-toggle");

  function updateAnimUI(isCinematic) {
    if (animIcon) {
      animIcon.className = isCinematic ? "fa-solid fa-wand-magic-sparkles text-sm text-blue-500" : "fa-solid fa-align-left text-sm text-gray-500 dark:text-gray-400";
    }
    if (animIconMobile) {
      animIconMobile.className = isCinematic ? "fa-solid fa-wand-magic-sparkles text-blue-500" : "fa-solid fa-align-left text-gray-500 dark:text-gray-400";
    }
    if (animToggleMobile) {
      const span = animToggleMobile.querySelector("span");
      if (span) span.textContent = isCinematic ? "Modo Cinemático" : "Modo Plano";
    }
    if (animToggle) {
      animToggle.title = isCinematic ? "Modo Cinemático" : "Modo Plano";
    }
  }

  function toggleAnim() {
    document.documentElement.classList.toggle("cinematic-enabled");
    const isCinematic = document.documentElement.classList.contains("cinematic-enabled");
    localStorage.setItem("cinematic-mode", isCinematic ? "true" : "false");
    updateAnimUI(isCinematic);
    window.dispatchEvent(new Event('cinematic-toggled'));
  }

  if (animToggle) animToggle.addEventListener("click", toggleAnim);
  if (animToggleMobile) animToggleMobile.addEventListener("click", toggleAnim);

  function updateUI(isDark) {
    const iconClass = isDark ? "fa-sun" : "fa-moon";
    const text = isDark ? lightText : darkText;

    if (themeIcon) {
      themeIcon.className = `fa-solid ${iconClass} text-sm`;
    }
    if (themeIconMobile) {
      themeIconMobile.className = `fa-solid ${iconClass}`;
    }
    if (themeToggleMobile) {
      const span = themeToggleMobile.querySelector("span");
      if (span) span.textContent = text;
    }
  }

  function toggleTheme(event) {
    const x = event.clientX;
    const y = event.clientY;

    const endRadius = Math.hypot(
      Math.max(x, innerWidth - x),
      Math.max(y, innerHeight - y)
    );

    if (!document.startViewTransition) {
      document.documentElement.classList.toggle("dark");
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      updateUI(isDark);
      return;
    }

    const transition = document.startViewTransition(() => {
      document.documentElement.classList.toggle("dark");
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      updateUI(isDark);
    });

    transition.ready.then(() => {
      document.documentElement.animate(
        {
          clipPath: [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${endRadius}px at ${x}px ${y}px)`
          ]
        },
        {
          duration: 700,
          easing: "ease-in-out",
          pseudoElement: "::view-transition-new(root)"
        }
      );
    });
  }

  if (themeToggle) {
    themeToggle.addEventListener("click", toggleTheme);
  }
  if (themeToggleMobile) {
    themeToggleMobile.addEventListener("click", toggleTheme);
  }

  updateUI(document.documentElement.classList.contains("dark"));
  updateAnimUI(document.documentElement.classList.contains("cinematic-enabled"));

  // Scroll Spy for Navbar
  const navLinksList = document.querySelectorAll('.nav-link');
  const sections = Array.from(navLinksList).map(link => {
    const id = link.getAttribute('href');
    return id ? document.querySelector(id) : null;
  }).filter(Boolean);

  function updateScrollSpy() {
    let currentActiveId = '';
    let maxVisibleArea = 0;

    sections.forEach(section => {
      if (!section) return;
      const rect = section.getBoundingClientRect();
      const visibleWidth = Math.max(0, Math.min(rect.right, window.innerWidth) - Math.max(rect.left, 0));
      const visibleHeight = Math.max(0, Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0));
      const visibleArea = visibleWidth * visibleHeight;

      if (visibleArea > maxVisibleArea && visibleArea > 0) {
        maxVisibleArea = visibleArea;
        currentActiveId = '#' + section.id;
      }
    });

    if (currentActiveId) {
      navLinksList.forEach(link => {
        if (link.getAttribute('href') === currentActiveId) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
    }
  }

  window.addEventListener('scroll', updateScrollSpy, { passive: true });
  window.addEventListener('resize', updateScrollSpy);
  
  // Run immediately and after layout shifts
  updateScrollSpy();
  setTimeout(updateScrollSpy, 100);
  setTimeout(updateScrollSpy, 500);
</script>