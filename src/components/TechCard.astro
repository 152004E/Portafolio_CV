---
interface Props {
  name: string;
  level: string;
  icon: string;
  description: string;
  category?: string;
  projects?: string[];
  highlights?: string[];
}

const { name, level, icon, description, category = "", projects = [], highlights = [] } = Astro.props;

function getLevelColor(level: string) {
  if (level === "Avanzado" || level === "Advanced") return "bg-emerald-500/15 text-emerald-400 border-emerald-500/25";
  if (level === "Intermedio" || level === "Intermediate") return "bg-blue-500/15 text-blue-400 border-blue-500/25";
  return "bg-yellow-500/15 text-yellow-400 border-yellow-500/25";
}
---

<div 
  class="tech-card-trigger group relative overflow-hidden rounded-2xl border border-gray-200/60 dark:border-white/10 bg-gray-50 dark:bg-white/[0.02] backdrop-blur-md p-4 transition-all duration-300 hover:-translate-y-1 hover:border-blue-500/40 hover:shadow-[0_0_25px_rgba(59,130,246,0.12)] cursor-pointer"
  data-tech-name={name}
  data-tech-level={level}
  data-tech-icon={icon}
  data-tech-description={description}
  data-tech-category={category}
  data-tech-projects={JSON.stringify(projects)}
  data-tech-highlights={JSON.stringify(highlights)}
  role="button"
  tabindex="0"
  aria-label={`Ver detalles de ${name}`}
>
  <div class="absolute -top-20 -right-20 w-40 h-40 bg-blue-500/5 rounded-full blur-3xl group-hover:bg-blue-500/10 transition-all duration-500"></div>
  <div class="relative z-10 flex flex-col gap-2">
    <div class="flex items-start gap-3">
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-500/10 text-blue-400 text-base group-hover:bg-blue-500/20 group-hover:text-blue-300 transition-all duration-300">
        <i class={icon}></i>
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center justify-between gap-2">
          <h4 class="text-gray-800 dark:text-white font-semibold text-sm group-hover:text-blue-400 transition-colors">{name}</h4>
          <span class={`shrink-0 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider border ${getLevelColor(level)}`}>
            {level}
          </span>
        </div>
        <p class="text-gray-500 dark:text-gray-400 text-xs mt-1 leading-relaxed line-clamp-2">
          {description}
        </p>
      </div>
    </div>

    <!-- Quick info bar -->
    <div class="flex items-center justify-between pt-2 border-t border-gray-200/50 dark:border-white/5 text-[11px] text-blue-500/75 dark:text-blue-400/80 group-hover:text-blue-600 dark:group-hover:text-cyan-300 transition-colors">
      <span class="flex items-center gap-1.5 font-medium">
        <i class="fa-solid fa-layer-group text-[10px]"></i>
        {projects.length > 0 ? `${projects.length} ${projects.length === 1 ? 'proyecto' : 'proyectos'}` : 'Ver detalles'}
      </span>
      <span class="flex items-center gap-1 text-[10px] font-semibold opacity-80 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">
        <span>Detalles</span>
        <i class="fa-solid fa-chevron-right text-[9px]"></i>
      </span>
    </div>
  </div>
</div>
