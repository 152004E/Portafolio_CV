---
import TechCard from './TechCard.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const categories = [
  {
    title: lang === 'es' ? "Frontend" : "Frontend",
    icon: "fa-solid fa-display",
    technologies: [
      { name: "React", level: lang === 'es' ? "Intermedio" : "Intermediate", icon: "fa-brands fa-react", description: lang === 'es' ? "Componentes funcionales, hooks, estado global, React Router." : "Functional components, hooks, global state, React Router." },
      { name: "TypeScript", level: lang === 'es' ? "Intermedio" : "Intermediate", icon: "fa-brands fa-js", description: lang === 'es' ? "Tipado estático, interfaces, genéricos, tipos avanzados." : "Static typing, interfaces, generics, advanced types." },
      { name: "JavaScript", level: lang === 'es' ? "Intermedio" : "Intermediate", icon: "fa-brands fa-js", description: lang === 'es' ? "ES6+, asincronía, manipulación del DOM, fetch API." : "ES6+, async, DOM manipulation, fetch API." },
      { name: "TailwindCSS", level: lang === 'es' ? "Avanzado" : "Advanced", icon: "fa-brands fa-css3-alt", description: lang === 'es' ? "Diseño utility-first, responsive, custom config, animaciones." : "Utility-first design, responsive, custom config, animations." },
      { name: "Bootstrap", level: lang === 'es' ? "Avanzado" : "Advanced", icon: "fa-brands fa-bootstrap", description: lang === 'es' ? "Grid system, componentes, personalización de temas." : "Grid system, components, theme customization." },
      { name: "HTML & CSS", level: lang === 'es' ? "Avanzado" : "Advanced", icon: "fa-brands fa-html5", description: lang === 'es' ? "Semántica web, flexbox, grid, animaciones CSS, SASS." : "Web semantics, flexbox, grid, CSS animations, SASS." },
    ],
  },
  {
    title: lang === 'es' ? "Backend" : "Backend",
    icon: "fa-solid fa-server",
    technologies: [
      { name: "Java", level: lang === 'es' ? "Intermedio" : "Intermediate", icon: "fa-brands fa-java", description: lang === 'es' ? "POO, colecciones, streams, manejo de excepciones, JDBC." : "OOP, collections, streams, exception handling, JDBC." },
      { name: "Spring Boot", level: lang === 'es' ? "Intermedio" : "Intermediate", icon: "fa-solid fa-leaf", description: lang === 'es' ? "REST APIs, JPA, seguridad, inyección de dependencias." : "REST APIs, JPA, security, dependency injection." },
      { name: "Node.js", level: lang === 'es' ? "Intermedio" : "Intermediate", icon: "fa-brands fa-node-js", description: lang === 'es' ? "Express, APIs REST, manejo de paquetes, npm." : "Express, REST APIs, package management, npm." },
      { name: "PHP", level: lang === 'es' ? "Básico" : "Basic", icon: "fa-brands fa-php", description: lang === 'es' ? "Lógica del lado del servidor, conexión a bases de datos." : "Server-side logic, database connection." },
    ],
  },
  {
    title: lang === 'es' ? "Bases de Datos" : "Databases",
    icon: "fa-solid fa-database",
    technologies: [
      { name: "PostgreSQL", level: lang === 'es' ? "Intermedio" : "Intermediate", icon: "fa-solid fa-database", description: lang === 'es' ? "Consultas SQL, joins, índices, normalización de datos." : "SQL queries, joins, indexes, data normalization." },
      { name: "MySQL", level: lang === 'es' ? "Intermedio" : "Intermediate", icon: "fa-solid fa-database", description: lang === 'es' ? "Diseño relacional, procedimientos almacenados, optimización." : "Relational design, stored procedures, optimization." },
    ],
  },
  {
    title: lang === 'es' ? "Herramientas" : "Tools",
    icon: "fa-solid fa-tools",
    technologies: [
      { name: "Git & GitHub", level: lang === 'es' ? "Intermedio" : "Intermediate", icon: "fa-brands fa-git-alt", description: lang === 'es' ? "Control de versiones, ramas, pull requests, flujo colaborativo." : "Version control, branches, pull requests, collaborative workflow." },
      { name: "Docker", level: lang === 'es' ? "Básico" : "Basic", icon: "fa-brands fa-docker", description: lang === 'es' ? "Contenedores, imágenes, docker-compose, entornos aislados." : "Containers, images, docker-compose, isolated environments." },
      { name: "Linux", level: lang === 'es' ? "Intermedio" : "Intermediate", icon: "fa-brands fa-linux", description: lang === 'es' ? "Terminal, comandos, permisos, scripts bash, servidores." : "Terminal, commands, permissions, bash scripts, servers." },
      { name: "Claude Code", level: lang === 'es' ? "Básico" : "Basic", icon: "fa-solid fa-robot", description: lang === 'es' ? "Asistente de codificación con IA para desarrollo asistido." : "AI coding assistant for assisted development." },
      { name: "OpenCode", level: lang === 'es' ? "Básico" : "Basic", icon: "fa-solid fa-terminal", description: lang === 'es' ? "CLI interactivo para ingeniería de software con IA." : "Interactive CLI for software engineering with AI." },
      { name: "Ollama", level: lang === 'es' ? "Básico" : "Basic", icon: "fa-solid fa-brain", description: lang === 'es' ? "Ejecución local de modelos de lenguaje para desarrollo." : "Local execution of language models for development." },
      { name: "Stitch", level: lang === 'es' ? "Básico" : "Basic", icon: "fa-solid fa-code-branch", description: lang === 'es' ? "Plataforma de diseño integrando IA." : "Design platform integrating AI." },
      { name: "Power Automate", level: lang === 'es' ? "Básico" : "Basic", icon: "fa-solid fa-bolt", description: lang === 'es' ? "Automatización de procesos empresariales con Microsoft." : "Business process automation with Microsoft." },
    ],
  },
];

function getLevelColor(level: string) {
  if (level === "Avanzado" || level === "Advanced" || level === "高级") return "bg-emerald-500/15 text-emerald-400 border-emerald-500/25";
  if (level === "Intermedio" || level === "Intermediate" || level === "中级") return "bg-blue-500/15 text-blue-400 border-blue-500/25";
  return "bg-yellow-500/15 text-yellow-400 border-yellow-500/25";
}
---

<section id="tecnologias" class="relative py-20 md:py-28 overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-14" data-aos="fade-up">
      <span class="inline-block bg-blue-500/20 text-blue-400 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">
        {lang === 'es' ? "Skills" : "Skills" 
      }</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white leading-tight">
        {lang === 'es' ? "Stack" : "Main" }<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-blue-300 to-cyan-400">{lang === 'es' ? "Principal" : "Stack" }</span>
      </h2>
      <p class="text-gray-500 mt-3 text-sm md:text-base max-w-xl mx-auto">
        {lang === 'es' ? "Tecnologías con las que trabajo día a día para construir soluciones completas y escalables." : "Technologies I work with daily to build complete and scalable solutions." 
      }</p>
    </div>

    <div class="relative grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-0">
      <!-- Vertical Divider -->
      <div class="hidden lg:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-blue-500/20 via-blue-400/10 to-transparent -translate-x-1/2"></div>

      <!-- Left Column: Backend + Tools -->
      <div class="flex flex-col gap-10 lg:pr-8">
        <div data-aos="fade-up" data-aos-delay="100">
          <div class="flex items-center gap-3 mb-5">
            <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-100 dark:bg-white/[0.03] border border-gray-200/60 dark:border-white/10">
              <i class="fa-solid fa-server text-blue-400 text-sm"></i>
              <h3 class="text-gray-800 dark:text-white font-semibold text-lg">{categories[1].title}</h3>
            </div>
            <div class="flex-1 h-px bg-gradient-to-r from-blue-500/20 to-transparent"></div>
          </div>
          <div class="grid grid-cols-1 gap-3">
            {categories[1].technologies.map((tech, i) => (
              <div class={i >= 3 ? "hidden tech-item-backend" : ""}>
                <TechCard icon={tech.icon} name={tech.name} level={tech.level} description={tech.description} />
              </div>
            ))}
          </div>
          {categories[1].technologies.length > 3 && (
            <button 
              class="mt-4 flex items-center justify-center gap-2 w-full py-2.5 rounded-xl border border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-300 text-sm font-semibold transition-all hover:bg-gray-100 dark:hover:bg-white/[0.03] tech-toggle-btn"
              data-target="tech-item-backend"
              data-expanded="false"
              data-text-more={lang === 'es' ? 'Ver más' : 'See more'}
              data-text-less={lang === 'es' ? 'Ver menos' : 'See less'}
            >
              <span>{lang === 'es' ? 'Ver más' : 'See more'}</span>
              <i class="fa-solid fa-chevron-down transition-transform duration-300"></i>
            </button>
          )}
        </div>

        <div data-aos="fade-up" data-aos-delay="300">
          <div class="flex items-center gap-3 mb-5">
            <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-100 dark:bg-white/[0.03] border border-gray-200/60 dark:border-white/10">
              <i class="fa-solid fa-tools text-blue-400 text-sm"></i>
              <h3 class="text-gray-800 dark:text-white font-semibold text-lg">{categories[3].title}</h3>
            </div>
            <div class="flex-1 h-px bg-gradient-to-r from-blue-500/20 to-transparent"></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {categories[3].technologies.map((tech, i) => (
              <div class={i >= 4 ? "hidden tech-item-tools" : ""}> 
                <!-- Changed to i >= 4 since tools uses a 2-column grid sm:grid-cols-2, so showing 4 initially is better balanced -->
                <TechCard icon={tech.icon} name={tech.name} level={tech.level} description={tech.description} />
              </div>
            ))}
          </div>
          {categories[3].technologies.length > 4 && (
            <button 
              class="mt-4 flex items-center justify-center gap-2 w-full py-2.5 rounded-xl border border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-300 text-sm font-semibold transition-all hover:bg-gray-100 dark:hover:bg-white/[0.03] tech-toggle-btn"
              data-target="tech-item-tools"
              data-expanded="false"
              data-text-more={lang === 'es' ? 'Ver más' : 'See more'}
              data-text-less={lang === 'es' ? 'Ver menos' : 'See less'}
            >
              <span>{lang === 'es' ? 'Ver más' : 'See more'}</span>
              <i class="fa-solid fa-chevron-down transition-transform duration-300"></i>
            </button>
          )}
        </div>
      </div>

      <!-- Right Column: Frontend + Databases -->
      <div class="flex flex-col gap-10 lg:pl-8">
        <div data-aos="fade-up">
          <div class="flex items-center gap-3 mb-5">
            <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-100 dark:bg-white/[0.03] border border-gray-200/60 dark:border-white/10">
              <i class="fa-solid fa-display text-blue-400 text-sm"></i>
              <h3 class="text-gray-800 dark:text-white font-semibold text-lg">{categories[0].title}</h3>
            </div>
            <div class="flex-1 h-px bg-gradient-to-r from-blue-500/20 to-transparent"></div>
          </div>
          <div class="grid grid-cols-1 gap-3">
            {categories[0].technologies.map((tech, i) => (
              <div class={i >= 3 ? "hidden tech-item-frontend" : ""}>
                <TechCard icon={tech.icon} name={tech.name} level={tech.level} description={tech.description} />
              </div>
            ))}
          </div>
          {categories[0].technologies.length > 3 && (
            <button 
              class="mt-4 flex items-center justify-center gap-2 w-full py-2.5 rounded-xl border border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-300 text-sm font-semibold transition-all hover:bg-gray-100 dark:hover:bg-white/[0.03] tech-toggle-btn"
              data-target="tech-item-frontend"
              data-expanded="false"
              data-text-more={lang === 'es' ? 'Ver más' : 'See more'}
              data-text-less={lang === 'es' ? 'Ver menos' : 'See less'}
            >
              <span>{lang === 'es' ? 'Ver más' : 'See more'}</span>
              <i class="fa-solid fa-chevron-down transition-transform duration-300"></i>
            </button>
          )}
        </div>

        <div data-aos="fade-up" data-aos-delay="200">
          <div class="flex items-center gap-3 mb-5">
            <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-100 dark:bg-white/[0.03] border border-gray-200/60 dark:border-white/10">
              <i class="fa-solid fa-database text-blue-400 text-sm"></i>
              <h3 class="text-gray-800 dark:text-white font-semibold text-lg">{categories[2].title}</h3>
            </div>
            <div class="flex-1 h-px bg-gradient-to-r from-blue-500/20 to-transparent"></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {categories[2].technologies.map((tech, i) => (
              <div class={i >= 3 ? "hidden tech-item-db" : ""}>
                <TechCard icon={tech.icon} name={tech.name} level={tech.level} description={tech.description} />
              </div>
            ))}
          </div>
          {categories[2].technologies.length > 3 && (
            <button 
              class="mt-4 flex items-center justify-center gap-2 w-full py-2.5 rounded-xl border border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-300 text-sm font-semibold transition-all hover:bg-gray-100 dark:hover:bg-white/[0.03] tech-toggle-btn"
              data-target="tech-item-db"
              data-expanded="false"
              data-text-more={lang === 'es' ? 'Ver más' : 'See more'}
              data-text-less={lang === 'es' ? 'Ver menos' : 'See less'}
            >
              <span>{lang === 'es' ? 'Ver más' : 'See more'}</span>
              <i class="fa-solid fa-chevron-down transition-transform duration-300"></i>
            </button>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtns = document.querySelectorAll('.tech-toggle-btn');
    toggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetClass = btn.getAttribute('data-target');
        const hiddenItems = document.querySelectorAll(`.${targetClass}`);
        const isExpanded = btn.getAttribute('data-expanded') === 'true';
        
        hiddenItems.forEach(item => {
          if (isExpanded) {
            item.classList.add('hidden');
          } else {
            item.classList.remove('hidden');
            item.style.animation = 'fadeIn 0.5s ease-out forwards';
          }
        });
        
        btn.setAttribute('data-expanded', !isExpanded);
        
        const span = btn.querySelector('span');
        const icon = btn.querySelector('i');
        
        if (isExpanded) {
          span.textContent = btn.getAttribute('data-text-more');
          icon.style.transform = 'rotate(0deg)';
        } else {
          span.textContent = btn.getAttribute('data-text-less');
          icon.style.transform = 'rotate(180deg)';
        }
      });
    });
  });
</script>
