---
import TechCard from './TechCard.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const categories = [
  {
    title: lang === 'es' ? "Frontend" : "Frontend",
    icon: "fa-solid fa-display",
    technologies: [
      { 
        name: "React", 
        level: lang === 'es' ? "Intermedio" : "Intermediate", 
        icon: "fa-brands fa-react", 
        description: lang === 'es' ? "Componentes funcionales, hooks, estado global, React Router." : "Functional components, hooks, global state, React Router.",
        projects: ["ROOM 911", "DuoBalance", "AlgoTrainer", "HuertaDirecta", "Portafolio CV"],
        highlights: lang === 'es' 
          ? [
              "Desarrollo de interfaces reactivas con estado global y custom hooks.",
              "Consumo e integración de APIs REST protegidas con autenticación JWT.",
              "Diseño modular de componentes reutilizables con alto rendimiento."
            ]
          : [
              "Reactive UI development using global state and custom hooks.",
              "Consumption and integration of protected REST APIs with JWT auth.",
              "Modular design of reusable, high-performance web components."
            ]
      },
      { 
        name: "TypeScript", 
        level: lang === 'es' ? "Intermedio" : "Intermediate", 
        icon: "fa-brands fa-js", 
        description: lang === 'es' ? "Tipado estático, interfaces, genéricos, tipos avanzados." : "Static typing, interfaces, generics, advanced types.",
        projects: ["DuoBalance", "AlgoTrainer", "Portafolio CV"],
        highlights: lang === 'es'
          ? [
              "Tipado estricto de entidades, DTOs y modelos de datos relacionales.",
              "Definición de contratos de API e interfaces para reducir errores en tiempo de ejecución.",
              "Arquitectura de software escalable con genéricos y tipos utilitarios."
            ]
          : [
              "Strict typing for entities, DTOs, and relational database models.",
              "API contract and interface definitions preventing runtime exceptions.",
              "Scalable software architecture leveraging generics and utility types."
            ]
      },
      { 
        name: "JavaScript", 
        level: lang === 'es' ? "Intermedio" : "Intermediate", 
        icon: "fa-brands fa-js", 
        description: lang === 'es' ? "ES6+, asincronía, manipulación del DOM, fetch API." : "ES6+, async, DOM manipulation, fetch API.",
        projects: ["HuertaDirecta", "AlgoTrainer", "Proyectos Web"],
        highlights: lang === 'es'
          ? [
              "Programación asíncrona avanzada con async/await, promesas y manejo de errores.",
              "Manipulación dinámica del DOM y optimización de eventos del navegador.",
              "Lógica matemática para reconocimiento y cronometraje de algoritmos de speedcubing."
            ]
          : [
              "Advanced asynchronous workflows with async/await, promises, and error handling.",
              "Dynamic DOM manipulation and event listener optimization.",
              "Algorithmic math logic for speedcuber pattern recognition."
            ]
      },
      { 
        name: "TailwindCSS", 
        level: lang === 'es' ? "Avanzado" : "Advanced", 
        icon: "fa-brands fa-css3-alt", 
        description: lang === 'es' ? "Diseño utility-first, responsive, custom config, animaciones." : "Utility-first design, responsive, custom config, animations.",
        projects: ["DuoBalance", "HuertaDirecta", "Portafolio CV"],
        highlights: lang === 'es'
          ? [
              "Construcción de interfaces responsivas y adaptativas para móvil y escritorio.",
              "Implementación de modo oscuro dinámico y variables de diseño personalizadas.",
              "Efectos glassmorphism, micro-interacciones y transiciones fluidas."
            ]
          : [
              "Building adaptive and responsive interfaces across mobile and desktop.",
              "Dynamic dark mode implementations and custom design tokens.",
              "Glassmorphic styling, micro-interactions, and fluid transitions."
            ]
      },
      { 
        name: "Bootstrap", 
        level: lang === 'es' ? "Avanzado" : "Advanced", 
        icon: "fa-brands fa-bootstrap", 
        description: lang === 'es' ? "Grid system, componentes, personalización de temas." : "Grid system, components, theme customization.",
        projects: ["ROOM 911", "Sistemas SENA"],
        highlights: lang === 'es'
          ? [
              "Maquetación del panel administrativo y dashboards de gestión de empleados.",
              "Sistemas de grillas responsivas y validación de formularios empresariales.",
              "Personalización de temas y componentes modulares corporativos."
            ]
          : [
              "Dashboard layouts and employee management views in enterprise systems.",
              "Responsive grid structures and enterprise form validation.",
              "Customizing corporate component systems and UI styling."
            ]
      },
      { 
        name: "HTML & CSS", 
        level: lang === 'es' ? "Avanzado" : "Advanced", 
        icon: "fa-brands fa-html5", 
        description: lang === 'es' ? "Semántica web, flexbox, grid, animaciones CSS, SASS." : "Web semantics, flexbox, grid, CSS animations, SASS.",
        projects: ["ROOM 911", "DuoBalance", "AlgoTrainer", "HuertaDirecta", "Portafolio CV"],
        highlights: lang === 'es'
          ? [
              "Marcado semántico accesible y optimizado para motores de búsqueda (SEO).",
              "Maquetación avanzada con Flexbox y CSS Grid para layouts complejos.",
              "Hojas de estilo para impresión y generación de documentos PDF de 2 columnas."
            ]
          : [
              "Accessible semantic markup optimized for search engine indexing (SEO).",
              "Advanced layouts using Flexbox and multi-column CSS Grid.",
              "Print-specific stylesheets and dual-column PDF document generation."
            ]
      },
    ],
  },
  {
    title: lang === 'es' ? "Backend" : "Backend",
    icon: "fa-solid fa-server",
    technologies: [
      { 
        name: "NestJS", 
        level: lang === 'es' ? "Intermedio" : "Intermediate", 
        icon: "fa-solid fa-server", 
        description: lang === 'es' ? "Arquitectura modular, controladores REST, servicios inyectables, Prisma." : "Modular architecture, REST controllers, injectable services, Prisma.",
        projects: ["DuoBalance"],
        highlights: lang === 'es'
          ? [
              "Diseño de arquitectura modular con controladores, servicios y validación DTO.",
              "Autenticación JWT completa con refresh tokens, guards y bcrypt.",
              "Lógica financiera de liquidación neta y balance de gastos compartidos con Prisma ORM."
            ]
          : [
              "Modular architecture with controllers, dependency-injected services, and DTO validation.",
              "Complete JWT authentication with refresh tokens, guards, and bcrypt hashing.",
              "Net settlement calculations and shared balance algorithms via Prisma ORM."
            ]
      },
      { 
        name: "Java", 
        level: lang === 'es' ? "Intermedio" : "Intermediate", 
        icon: "fa-brands fa-java", 
        description: lang === 'es' ? "POO, colecciones, streams, manejo de excepciones, JDBC." : "OOP, collections, streams, exception handling, JDBC.",
        projects: ["ROOM 911", "Sistemas SENA"],
        highlights: lang === 'es'
          ? [
              "Programación orientada a objetos con patrones de diseño empresariales.",
              "Procesamiento funcional de colecciones con la API Stream de Java.",
              "Arquitectura de software desacoplada y manejo robusto de excepciones."
            ]
          : [
              "Object-oriented programming using enterprise design patterns.",
              "Functional collection processing using the modern Java Stream API.",
              "Decoupled software architecture with resilient exception handling."
            ]
      },
      { 
        name: "Spring Boot", 
        level: lang === 'es' ? "Intermedio" : "Intermediate", 
        icon: "fa-solid fa-leaf", 
        description: lang === 'es' ? "REST APIs, JPA, seguridad, inyección de dependencias." : "REST APIs, JPA, security, dependency injection.",
        projects: ["ROOM 911"],
        highlights: lang === 'es'
          ? [
              "Desarrollo del backend empresarial de control de acceso con Spring Boot.",
              "Seguridad con Spring Security y tokens de autenticación JWT.",
              "Persistencia relacional con Spring Data JPA y mapeo de entidades relacionales."
            ]
          : [
              "Enterprise access control backend development with Spring Boot.",
              "Security architecture with Spring Security and JWT tokens.",
              "Relational persistence using Spring Data JPA and entity mappings."
            ]
      },
      { 
        name: "Node.js", 
        level: lang === 'es' ? "Intermedio" : "Intermediate", 
        icon: "fa-brands fa-node-js", 
        description: lang === 'es' ? "Express, APIs REST, manejo de paquetes, npm/pnpm." : "Express, REST APIs, package management, npm/pnpm.",
        projects: ["DuoBalance", "HuertaDirecta", "Scripts de Automatización"],
        highlights: lang === 'es'
          ? [
              "Desarrollo de servicios de backend rápidos y scripts de generación de assets.",
              "Manejo estricto de dependencias y scripts de construcción con pnpm.",
              "Integración de librerías nativas del sistema como headless browser y docx."
            ]
          : [
              "Fast backend services development and asset generation scripts.",
              "Strict package workflows and build lifecycle automation with pnpm.",
              "Integration with headless system engines and native docx generation."
            ]
      },
      { 
        name: "PHP", 
        level: lang === 'es' ? "Básico" : "Basic", 
        icon: "fa-brands fa-php", 
        description: lang === 'es' ? "Lógica del lado del servidor, conexión a bases de datos." : "Server-side logic, database connection.",
        projects: ["Sistemas SENA"],
        highlights: lang === 'es'
          ? [
              "Procesamiento de peticiones HTTP del servidor y generación dinámica de vistas.",
              "Conexión y ejecución de consultas relacionales a MySQL.",
              "Manejo de sesiones de usuario y validación básica de entrada."
            ]
          : [
              "HTTP request handling and dynamic server-rendered view processing.",
              "Connection and execution of relational queries against MySQL.",
              "Session lifecycle management and user input sanitization."
            ]
      },
    ],
  },
  {
    title: lang === 'es' ? "Bases de Datos" : "Databases",
    icon: "fa-solid fa-database",
    technologies: [
      { 
        name: "PostgreSQL", 
        level: lang === 'es' ? "Intermedio" : "Intermediate", 
        icon: "fa-solid fa-database", 
        description: lang === 'es' ? "Consultas SQL, joins, índices, normalización de datos." : "SQL queries, joins, indexes, data normalization.",
        projects: ["ROOM 911", "DuoBalance"],
        highlights: lang === 'es'
          ? [
              "Diseño y normalización de esquemas relacionales para usuarios, grupos y transacciones.",
              "Consultas optimizadas con JOINs, índices y claves foráneas.",
              "Migraciones y gestión de esquemas mediante Prisma ORM y JPA/Hibernate."
            ]
          : [
              "Relational schema modeling and normalization for users, groups, and transactions.",
              "Optimized relational queries using JOINs, composite indexes, and foreign keys.",
              "Schema migrations and data integrity via Prisma ORM and JPA/Hibernate."
            ]
      },
      { 
        name: "MySQL", 
        level: lang === 'es' ? "Intermedio" : "Intermediate", 
        icon: "fa-solid fa-database", 
        description: lang === 'es' ? "Diseño relacional, procedimientos almacenados, optimización." : "Relational design, stored procedures, optimization.",
        projects: ["HuertaDirecta", "Sistemas SENA"],
        highlights: lang === 'es'
          ? [
              "Modelado de catálogos de productos agrícolas y pedidos en tiempo real.",
              "Definición de claves primarias, foráneas e integridad referencial.",
              "Optimización de consultas SQL para dashboards y reportes."
            ]
          : [
              "Agricultural product catalog modeling and real-time order tracking.",
              "Foreign key constraints and strict referential integrity enforcement.",
              "SQL query optimization for operational reporting."
            ]
      },
    ],
  },
  {
    title: lang === 'es' ? "Herramientas" : "Tools",
    icon: "fa-solid fa-tools",
    technologies: [
      { 
        name: "Git & GitHub", 
        level: lang === 'es' ? "Intermedio" : "Intermediate", 
        icon: "fa-brands fa-git-alt", 
        description: lang === 'es' ? "Control de versiones, ramas, pull requests, flujo colaborativo." : "Version control, branches, pull requests, collaborative workflow.",
        projects: ["ROOM 911", "DuoBalance", "AlgoTrainer", "HuertaDirecta", "Ainglo", "Portafolio CV"],
        highlights: lang === 'es'
          ? [
              "Estrategias de ramificación con Git Flow y control de versiones distribuido.",
              "Resolución de conflictos y revisión de Pull Requests en entornos de equipo.",
              "Publicación y despliegue continuo vinculado a repositorios."
            ]
          : [
              "Branching strategies using Git Flow and distributed version control.",
              "Merge conflict resolution and collaborative Pull Request reviews.",
              "Continuous delivery linked directly with remote git workflows."
            ]
      },
      { 
        name: "Docker", 
        level: lang === 'es' ? "Básico" : "Basic", 
        icon: "fa-brands fa-docker", 
        description: lang === 'es' ? "Contenedores, imágenes, docker-compose, entornos aislados." : "Containers, images, docker-compose, isolated environments.",
        projects: ["ROOM 911", "DuoBalance"],
        highlights: lang === 'es'
          ? [
              "Levantamiento de contenedores de bases de datos PostgreSQL con docker-compose.",
              "Aislamiento de entornos de desarrollo para evitar discrepancias de configuración.",
              "Gestión de volúmenes persistentes y variables de entorno para servicios."
            ]
          : [
              "Spinning up PostgreSQL container instances using docker-compose.",
              "Isolated development environments preventing environment drift.",
              "Managing persistent data volumes and multi-stage container services."
            ]
      },
      { 
        name: "Linux", 
        level: lang === 'es' ? "Intermedio" : "Intermediate", 
        icon: "fa-brands fa-linux", 
        description: lang === 'es' ? "Terminal, comandos, permisos, scripts bash, servidores." : "Terminal, commands, permissions, bash scripts, servers.",
        projects: ["Entorno de Desarrollo & Servidores"],
        highlights: lang === 'es'
          ? [
              "Operación diaria en distribuciones Linux (Fedora / Ubuntu / Debian).",
              "Scripts bash para automatización de compilaciones y pipelines de activos.",
              "Gestión de permisos de archivos, procesos de fondo y herramientas de red."
            ]
          : [
              "Daily workflow inside Linux desktop/server environments (Fedora/Ubuntu/Debian).",
              "Bash automation scripting for asset compilation and development pipelines.",
              "Process management, file permission administration, and network utilities."
            ]
      },
      { 
        name: "Claude Code", 
        level: lang === 'es' ? "Intermedio" : "Intermediate", 
        icon: "fa-solid fa-robot", 
        description: lang === 'es' ? "Asistente de codificación con IA para desarrollo asistido." : "AI coding assistant for assisted development.",
        projects: ["Portafolio CV", "DuoBalance"],
        highlights: lang === 'es'
          ? [
              "Pair programming guiado por IA para acelerar refactorizaciones complejas.",
              "Depuración exhaustiva y generación de suites de verificación técnica.",
              "Integración de mejores prácticas de TypeScript y optimización de arquitectura."
            ]
          : [
              "AI-assisted pair programming accelerating complex code refactors.",
              "Thorough debugging and creation of technical verification test suites.",
              "Adherence to TypeScript best practices and architectural optimization."
            ]
      },
      { 
        name: "OpenCode", 
        level: lang === 'es' ? "Básico" : "Basic", 
        icon: "fa-solid fa-terminal", 
        description: lang === 'es' ? "CLI interactivo para ingeniería de software con IA." : "Interactive CLI for software engineering with AI.",
        projects: ["Desarrollo CLI Asistido"],
        highlights: lang === 'es'
          ? [
              "Uso de asistentes basados en terminal para análisis estático de código.",
              "Iteración rápida sobre comandos del sistema y scripts de automatización."
            ]
          : [
              "Terminal-based assistants for static code inspection.",
              "Rapid iteration over shell utilities and automation scripts."
            ]
      },
      { 
        name: "Ollama", 
        level: lang === 'es' ? "Básico" : "Basic", 
        icon: "fa-solid fa-brain", 
        description: lang === 'es' ? "Ejecución local de modelos de lenguaje para desarrollo." : "Local execution of language models for development.",
        projects: ["Ainglo", "Experimentación Local"],
        highlights: lang === 'es'
          ? [
              "Ejecución offline de LLMs locales para asistencia de lenguaje en Ainglo.",
              "Pruebas de latencia y evaluación de prompts estructurados en JSON."
            ]
          : [
              "Running offline local LLMs for language tutoring in Ainglo.",
              "Latency benchmarking and structured JSON prompt engineering."
            ]
      },
      { 
        name: "Stitch", 
        level: lang === 'es' ? "Básico" : "Basic", 
        icon: "fa-solid fa-code-branch", 
        description: lang === 'es' ? "Plataforma de diseño integrando IA." : "Design platform integrating AI.",
        projects: ["Prototipado Visual"],
        highlights: lang === 'es'
          ? [
              "Exploración ágil de bocetos de interfaz y prototipado rápido de UI.",
              "Traducción de ideas conceptuales a componentes frontend reutilizables."
            ]
          : [
              "Agile UI sketching and rapid user interface wireframing.",
              "Translating concept ideas into reusable frontend components."
            ]
      },
      { 
        name: "Power Automate", 
        level: lang === 'es' ? "Básico" : "Basic", 
        icon: "fa-solid fa-bolt", 
        description: lang === 'es' ? "Automatización de procesos empresariales con Microsoft." : "Business process automation with Microsoft.",
        projects: ["Flujos Empresariales SENA"],
        highlights: lang === 'es'
          ? [
              "Automatización de notificaciones por correo y sincronización de datos.",
              "Disparadores basados en eventos para optimizar tareas administrativas repetitivas."
            ]
          : [
              "Automated email notification workflows and data synchronization.",
              "Event-driven triggers streamlining repetitive administrative tasks."
            ]
      },
    ],
  },
];

function getLevelColor(level: string) {
  if (level === "Avanzado" || level === "Advanced") return "bg-emerald-500/15 text-emerald-400 border-emerald-500/25";
  if (level === "Intermedio" || level === "Intermediate") return "bg-blue-500/15 text-blue-400 border-blue-500/25";
  return "bg-yellow-500/15 text-yellow-400 border-yellow-500/25";
}
---

<section id="tecnologias" class="relative py-20 md:py-28 overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-14" data-aos="fade-up">
      <span class="inline-block bg-blue-500/20 text-blue-400 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">
        {lang === 'es' ? "Skills & Tecnologías" : "Skills & Technologies"}
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white leading-tight">
        {lang === 'es' ? "Stack" : "Main" } <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 via-blue-300 to-cyan-400">{lang === 'es' ? "Principal" : "Stack" }</span>
      </h2>
      <p class="text-gray-500 mt-3 text-sm md:text-base max-w-xl mx-auto">
        {lang === 'es' 
          ? "Haz clic en cualquier tecnología para explorar los proyectos reales donde la utilicé y sus aplicaciones técnicas." 
          : "Click on any technology to explore the real projects where I used it and its technical applications."}
      </p>
    </div>

    <div class="relative grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-0">
      <!-- Vertical Divider -->
      <div class="hidden lg:block absolute left-1/2 top-0 bottom-0 w-px bg-linear-to-b from-blue-500/20 via-blue-400/10 to-transparent -translate-x-1/2"></div>

      <!-- Left Column: Backend + Tools -->
      <div class="flex flex-col gap-10 lg:pr-8">
        <!-- Backend -->
        <div data-aos="fade-up" data-aos-delay="100">
          <div class="flex items-center gap-3 mb-5">
            <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-100 dark:bg-white/3 border border-gray-200/60 dark:border-white/10">
              <i class="fa-solid fa-server text-blue-400 text-sm"></i>
              <h3 class="text-gray-800 dark:text-white font-semibold text-lg">{categories[1].title}</h3>
            </div>
            <div class="flex-1 h-px bg-linear-to-r from-blue-500/20 to-transparent"></div>
          </div>
          <div class="grid grid-cols-1 gap-3">
            {categories[1].technologies.map((tech, i) => (
              <div class={i >= 3 ? "hidden tech-item-backend" : ""}>
                <TechCard 
                  icon={tech.icon} 
                  name={tech.name} 
                  level={tech.level} 
                  description={tech.description}
                  category={categories[1].title}
                  projects={tech.projects}
                  highlights={tech.highlights}
                />
              </div>
            ))}
          </div>
          {categories[1].technologies.length > 3 && (
            <button 
              class="mt-4 flex items-center justify-center gap-2 w-full py-2.5 rounded-xl border border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-300 text-sm font-semibold transition-all hover:bg-gray-100 dark:hover:bg-white/3 tech-toggle-btn cursor-pointer"
              data-target="tech-item-backend"
              data-expanded="false"
              data-text-more={lang === 'es' ? 'Ver más' : 'See more'}
              data-text-less={lang === 'es' ? 'Ver menos' : 'See less'}
            >
              <span>{lang === 'es' ? 'Ver más' : 'See more'}</span>
              <i class="fa-solid fa-chevron-down transition-transform duration-300"></i>
            </button>
          )}
        </div>

        <!-- Herramientas -->
        <div data-aos="fade-up" data-aos-delay="300">
          <div class="flex items-center gap-3 mb-5">
            <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-gray-100 dark:bg-white/3 border border-gray-200/60 dark:border-white/10">
              <i class="fa-solid fa-tools text-blue-400 text-sm"></i>
              <h3 class="text-gray-800 dark:text-white font-semibold text-lg">{categories[3].title}</h3>
            </div>
            <div class="flex-1 h-px bg-linear-to-r from-blue-500/20 to-transparent"></div>
          </div>
          <div class="flex flex-wrap gap-4">
            {categories[3].technologies.map((tech, i) => (
              <div 
                class={`tech-card-trigger group relative cursor-pointer ${i >= 8 ? "hidden tech-item-tools" : ""}`}
                data-tech-name={tech.name}
                data-tech-level={tech.level}
                data-tech-icon={tech.icon}
                data-tech-description={tech.description}
                data-tech-category={categories[3].title}
                data-tech-projects={JSON.stringify(tech.projects)}
                data-tech-highlights={JSON.stringify(tech.highlights)}
                role="button"
                tabindex="0"
                aria-label={`Ver detalles de ${tech.name}`}
              >
                <!-- Icon Circle -->
                <div class="w-14 h-14 rounded-2xl bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 flex items-center justify-center group-hover:border-blue-500/50 group-hover:bg-blue-500/10 group-hover:-translate-y-1 transition-all duration-300 shadow-sm">
                  <i class={`${tech.icon} text-2xl text-gray-600 dark:text-gray-300 group-hover:text-blue-400 transition-colors`}></i>
                </div>

                <!-- Tooltip / Toast -->
                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-56 p-3 bg-gray-900 dark:bg-black/95 border border-white/10 rounded-xl shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50 transform translate-y-2 group-hover:translate-y-0 pointer-events-none">
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="font-bold text-white text-xs truncate mr-2">{tech.name}</span>
                    <span class={`shrink-0 text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded ${getLevelColor(tech.level)}`}>
                      {tech.level}
                    </span>
                  </div>
                  <p class="text-xs text-gray-400 leading-tight mb-1.5">
                    {tech.description}
                  </p>
                  <div class="text-[10px] text-blue-400 font-semibold flex items-center gap-1">
                    <span>{lang === 'es' ? 'Click para ver detalles' : 'Click for details'}</span>
                    <i class="fa-solid fa-arrow-right text-[8px]"></i>
                  </div>
                  <!-- Triangle pointer -->
                  <div class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-3 h-3 bg-gray-900 dark:bg-black/95 border-b border-r border-white/10 rotate-45"></div>
                </div>
              </div>
            ))}
          </div>
          {categories[3].technologies.length > 8 && (
            <button 
              class="mt-4 flex items-center justify-center gap-2 w-full py-2.5 rounded-xl border border-gray-200 dark:border-white/10 text-gray-500 dark:text-gray-300 text-sm font-semibold transition-all hover:bg-gray-100 dark:hover:bg-white/3 tech-toggle-btn cursor-pointer"
              data-target="tech-item-tools"
              data-expanded="false"
              data-text-more={lang === 'es' ? 'Ver más' : 'See more'}
              data-text-less={lang === 'es' ? 'Ver menos' : 'See less'}
            >
              <span>{lang === 'es' ? 'Ver más' : 'See more'}</span>
              <i class="fa-solid fa-chevron-down transition-transform duration-300"></i>
            </button>
          )}
        </div>
      </div>

      <!-- Right Column: Frontend + Databases -->
