<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tech Toggle Buttons (Ver más / Ver menos en grid)
    const toggleBtns = document.querySelectorAll('.tech-toggle-btn');
    toggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetClass = btn.getAttribute('data-target');
        const hiddenItems = document.querySelectorAll(`.${targetClass}`);
        const isExpanded = btn.getAttribute('data-expanded') === 'true';
        
        hiddenItems.forEach(item => {
          if (isExpanded) {
            item.classList.add('hidden');
          } else {
            item.classList.remove('hidden');
            if (item instanceof HTMLElement) {
              item.style.animation = 'fadeIn 0.5s ease-out forwards';
            }
          }
        });
        
        btn.setAttribute('data-expanded', String(!isExpanded));
        
        const span = btn.querySelector('span');
        const icon = btn.querySelector('i');
        
        if (isExpanded) {
          if (span) span.textContent = btn.getAttribute('data-text-more');
          if (icon) icon.style.transform = 'rotate(0deg)';
        } else {
          if (span) span.textContent = btn.getAttribute('data-text-less');
          if (icon) icon.style.transform = 'rotate(180deg)';
        }
      });
    });

    // 2. MODAL DE 3 PANELES CON ANIMACIÓN DE CAÍDA (GSAP Interruptible Single Timeline)
    const nav = document.getElementById('skillsNav');
    const navBg = document.getElementById('skillsNavBg');
    const closeBtn = document.getElementById('skillsMenuClose');
    const techTriggers = document.querySelectorAll('.tech-card-trigger');

    if (!nav || !navBg) return;

    let isOpen = false;
    let exitSpeed = 1.4;
    let tl: gsap.core.Timeline | null = null;
    let enterEndTime = 0;

    function initDrawerTimeline() {
      tl && tl.revert();

      gsap.set(nav, { visibility: "hidden" });
      gsap.set(navBg, { opacity: 0 });

      tl = gsap
        .timeline({ paused: true })
        .set(nav, { visibility: "visible", pointerEvents: "auto" })

        // ═══ ENTER ═══
        .to(
          navBg,
          {
            opacity: 1,
            duration: 0.4,
            ease: "power2.out",
            easeReverse: "power4.out"
          },
          0
        )
        .fromTo(
          ".skills-nav-panel",
          { x: "110%", y: 0, rotation: 0 },
          {
            x: "0%",
            y: 0,
            duration: 0.6,
            ease: "back.out",
            easeReverse: "power3.in",
            stagger: 0.08
          },
          0
        )
        .fromTo(
          ".bar-top",
          {
            attr: { x1: 3, y1: 7, x2: 17, y2: 7 }
          },
          {
            attr: { x1: 5, y1: 5, x2: 15, y2: 15 },
            duration: 0.35,
            ease: "back.out(1.4)",
            easeReverse: "power3.out"
          },
          0.06
        )
        .fromTo(
          ".bar-mid",
          { opacity: 1 },
          { opacity: 0, duration: 0.2 },
          0.06
        )
        .fromTo(
          ".bar-bot",
          {
            attr: { x1: 3, y1: 13, x2: 17, y2: 13 }
          },
          {
            attr: { x1: 15, y1: 5, x2: 5, y2: 15 },
            duration: 0.35,
            ease: "back.out(1.4)",
            easeReverse: "power3.out"
          },
          0.06
        )

        // ═══ PAUSE ═══
        .addPause();

      enterEndTime = tl.duration();

      // ═══ EXIT — PANELS FALL DOWN WITH STAGGER, BOTTOM FIRST! ═══
      tl
        // Morph X → hamburger
        .to(
          ".bar-mid",
          { opacity: 1, duration: 0.2 },
          "<"
        )
        .to(
          ".bar-top",
          {
            attr: { x1: 3, y1: 7, x2: 17, y2: 7 },
            duration: 0.2,
            ease: "power3.in"
          },
          "<"
        )
        .to(
          ".bar-bot",
          {
            attr: { x1: 3, y1: 13, x2: 17, y2: 13 },
            duration: 0.2,
            ease: "power3.in"
          },
          "<"
        )

        // panels fall
        .to(
          ".skills-nav-panel",
          {
            y: "115vh",
            rotation: "random(-25, 25)",
            duration: 0.9,
            ease: "power3.in",
            stagger: {
              from: "end",
              each: 0.04
            }
          },
          "<"
        )

        // bg fades
        .to(
          navBg,
          {
            opacity: 0,
            duration: 0.3,
            ease: "power2.in"
          },
          "<0.1"
        )

        .set(nav, { visibility: "hidden", pointerEvents: "none" });
    }

    // Inicializar timeline
    initDrawerTimeline();

    function populateModalData(triggerEl: Element) {
      const name = triggerEl.getAttribute('data-tech-name') || 'React';
      const level = triggerEl.getAttribute('data-tech-level') || 'Intermedio';
      const icon = triggerEl.getAttribute('data-tech-icon') || 'fa-brands fa-react';
      const desc = triggerEl.getAttribute('data-tech-description') || '';
      const category = triggerEl.getAttribute('data-tech-category') || 'Stack';

      let projects: string[] = [];
      let highlights: string[] = [];
      try {
        projects = JSON.parse(triggerEl.getAttribute('data-tech-projects') || '[]');
      } catch (e) {}
      try {
        highlights = JSON.parse(triggerEl.getAttribute('data-tech-highlights') || '[]');
      } catch (e) {}

      // 1. Panel Superior
      const modalIcon = document.getElementById('skillsModalIcon');
      const modalName = document.getElementById('skillsModalName');
      const modalCategory = document.getElementById('skillsModalCategory');
      const modalLevel = document.getElementById('skillsModalLevel');
      const modalDesc = document.getElementById('skillsModalDesc');
      const modalProjects = document.getElementById('skillsModalProjects');

      if (modalIcon) modalIcon.className = `${icon} text-2xl`;
      if (modalName) modalName.textContent = name;
      if (modalCategory) modalCategory.textContent = category;
      if (modalLevel) modalLevel.textContent = level;
      if (modalDesc) modalDesc.textContent = desc;

      if (modalProjects) {
        if (projects.length === 0) {
          modalProjects.innerHTML = `<span class="text-xs text-gray-400 italic">No especificado</span>`;
        } else {
          modalProjects.innerHTML = projects.map(p => `
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-blue-500/10 dark:bg-white/5 border border-blue-500/20 text-xs font-semibold text-blue-600 dark:text-cyan-300 shadow-xs">
              <i class="fa-solid fa-check text-[10px] text-emerald-400"></i>
              ${p}
            </span>
          `).join('');
        }
      }

      // 2. Panel Intermedio (Matcha)
      const middleTitle = document.getElementById('skillsMiddleTitle');
      const middleDesc = document.getElementById('skillsMiddleDesc');
      const middleIcon = document.getElementById('skillsMiddleBadgeIcon');

      if (middleIcon) middleIcon.className = `${icon} text-xl text-black`;
      if (middleTitle) {
        const topProjects = projects.slice(0, 2).join(' & ');
        middleTitle.textContent = topProjects ? `${topProjects} · ${name}` : `${name} en Producción`;
      }
      if (middleDesc) {
        if (highlights.length > 0) {
          middleDesc.innerHTML = highlights.join('<br class="my-1" />• ');
        } else {
          middleDesc.textContent = desc;
        }
      }
    }

    function toggle(targetEl?: Element) {
      if (!tl) return;

      if (targetEl) {
        populateModalData(targetEl);
      }

      isOpen = !isOpen;

      if (isOpen) {
        document.body.style.overflow = 'hidden';
        if (tl.time() >= enterEndTime) {
          tl.timeScale(1).restart();
        } else {
          tl.timeScale(1).play();
        }
      } else {
        document.body.style.overflow = '';
        if (tl.time() < enterEndTime) {
          tl.timeScale(exitSpeed).reverse();
        } else {
          tl.timeScale(1).play();
        }
      }
    }

    // Disparadores en las tarjetas de skills
    techTriggers.forEach(el => {
      el.addEventListener('click', () => {
        if (!isOpen) {
          toggle(el);
        } else {
          populateModalData(el);
          // Micro-animación de actualización de panel intermedio
          gsap.fromTo("#skillsNavMiddle", { scale: 0.97 }, { scale: 1, duration: 0.25, ease: "back.out" });
        }
      });
      el.addEventListener('keydown', (e) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          ke.preventDefault();
          toggle(el);
        }
      });
    });

    closeBtn?.addEventListener('click', () => toggle());
    navBg?.addEventListener('click', () => {
      if (isOpen) toggle();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        toggle();
      }
    });

    // Enlace de acción para cerrar al saltar a proyectos
    const projectAction = document.getElementById('skillsMiddleProjectAction');
    projectAction?.addEventListener('click', () => {
      if (isOpen) toggle();
    });
  });
</script>
