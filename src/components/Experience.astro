---
import StatsGrid from './StatsGrid.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="section-experiencia" class="relative py-20 md:py-28 overflow-hidden">
  <div class="absolute top-1/4 -left-32 w-96 h-96 bg-blue-500/8 rounded-full blur-3xl"></div>
  <div class="absolute bottom-1/3 -right-32 w-96 h-96 bg-cyan-500/8 rounded-full blur-3xl"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-14" data-aos="fade-up">
      <span class="inline-block bg-blue-500/20 text-blue-400 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-4">
        {t('exp.badge')}
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white leading-tight">
        <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 via-blue-300 to-cyan-400">
          {t('exp.title1')}
        </span>
        <span class="text-gray-400">{t('exp.title2')}</span>
      </h2>
    </div>

    <div data-aos="fade-up" data-aos-delay="100">
      <StatsGrid />
    </div>

    <!-- Timeline -->
    <div class="relative mt-16 md:mt-24 max-w-6xl mx-auto md:flex md:flex-row-reverse md:justify-between md:gap-6" data-aos="fade-up" data-aos-delay="200">
      <!-- Línea (Vertical en móvil, Horizontal en md) -->
      <div class="absolute left-4 md:left-0 top-0 bottom-0 md:bottom-auto md:top-8 md:h-px md:w-full bg-linear-to-b md:bg-linear-to-r from-blue-500/50 via-blue-400/20 to-transparent z-0"></div>

      <!-- Item 1 -->
      <div class="relative flex flex-col md:items-center md:flex-1 mb-12 md:mb-0">
        <!-- Fecha (Arriba en md) -->
        <div class="hidden md:flex md:w-full md:justify-center md:mb-6">
          <div class="text-center">
            <span class="text-sm font-semibold text-blue-400">{t('exp.present')}</span>
          </div>
        </div>

        <!-- Punto -->
        <div class="absolute left-4 md:absolute top-1 md:top-8 -translate-x-1/2 z-10 md:-translate-y-1/2">
          <div class="w-3.5 h-3.5 rounded-full bg-blue-500 shadow-[0_0_12px_rgba(59,130,246,0.6)] border-2 border-white dark:border-[#0a0a0f]"></div>
        </div>

        <!-- Contenido -->
        <div class="pl-10 md:pl-0 md:w-full md:px-2 md:mt-6">
          <div class="md:hidden mb-2">
            <span class="text-sm font-semibold text-blue-400">{t('exp.present')}</span>
          </div>
          <div class="rounded-2xl border border-gray-200/60 dark:border-white/10 bg-white dark:bg-white/3 backdrop-blur-md p-5 md:p-6 transition-all duration-300 hover:-translate-y-1 hover:border-blue-500/40 hover:shadow-[0_0_25px_rgba(59,130,246,0.1)] relative z-10">
            <h3 class="text-lg md:text-xl font-bold text-gray-900 dark:text-white mb-2">{t('exp.job1.title')}</h3>
            <p class="text-sm md:text-base text-gray-500 dark:text-gray-400 leading-relaxed">
              {t('exp.job1.desc')}
            </p>
          </div>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="relative flex flex-col md:items-center md:flex-1 mb-12 md:mb-0">
        <div class="hidden md:flex md:w-full md:justify-center md:mb-6">
          <div class="text-center">
            <span class="text-sm font-semibold text-blue-400">2024 - 2025</span>
          </div>
        </div>

        <div class="absolute left-4 md:absolute top-1 md:top-8 -translate-x-1/2 z-10 md:-translate-y-1/2">
          <div class="w-3.5 h-3.5 rounded-full border-2 border-blue-500 bg-white dark:bg-[#0a0a0f]"></div>
        </div>

        <div class="pl-10 md:pl-0 md:w-full md:px-2 md:mt-6">
          <div class="md:hidden mb-2">
            <span class="text-sm font-semibold text-blue-400">2024 - 2025</span>
          </div>
          <div class="rounded-2xl border border-gray-200/60 dark:border-white/10 bg-white dark:bg-white/3 backdrop-blur-md p-5 md:p-6 transition-all duration-300 hover:-translate-y-1 hover:border-blue-500/40 hover:shadow-[0_0_25px_rgba(59,130,246,0.1)] relative z-10">
            <h3 class="text-lg md:text-xl font-bold text-gray-900 dark:text-white mb-2">{t('exp.job2.title')}</h3>
            <p class="text-sm md:text-base text-gray-500 dark:text-gray-400 leading-relaxed">
              {t('exp.job2.desc')}
            </p>
          </div>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="relative flex flex-col md:items-center md:flex-1 last:mb-0">
        <div class="hidden md:flex md:w-full md:justify-center md:mb-6">
          <div class="text-center">
            <span class="text-sm font-semibold text-blue-400">2022 - 2023</span>
          </div>
        </div>

        <div class="absolute left-4 md:absolute top-1 md:top-8 -translate-x-1/2 z-10 md:-translate-y-1/2">
          <div class="w-3.5 h-3.5 rounded-full border-2 border-blue-500 bg-white dark:bg-[#0a0a0f]"></div>
        </div>

        <div class="pl-10 md:pl-0 md:w-full md:px-2 md:mt-6">
          <div class="md:hidden mb-2">
            <span class="text-sm font-semibold text-blue-400">2022 - 2023</span>
          </div>
          <div class="rounded-2xl border border-gray-200/60 dark:border-white/10 bg-white dark:bg-white/3 backdrop-blur-md p-5 md:p-6 transition-all duration-300 hover:-translate-y-1 hover:border-blue-500/40 hover:shadow-[0_0_25px_rgba(59,130,246,0.1)] relative z-10">
            <h3 class="text-lg md:text-xl font-bold text-gray-900 dark:text-white mb-2">{t('exp.job3.title')}</h3>
            <p class="text-sm md:text-base text-gray-500 dark:text-gray-400 leading-relaxed">
              {t('exp.job3.desc')}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
